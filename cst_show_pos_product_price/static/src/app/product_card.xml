<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'product-content')]" position="attributes">
            <attribute name="class" add="flex-column" separator=" "/>
        </xpath>

        <xpath expr="//div[contains(@class, 'product-name')]" position="after">
            <t t-if="pos.config.show_price">
                <div class="product-price text-primary fw-bolder mt-auto pt-1" 
                     t-esc="formattedPrice" 
                     style="font-size: 0.9em; width: 100%; text-align: center;"/>
            </t>
        </xpath>
    </t>
</templates>
