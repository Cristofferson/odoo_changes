<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Refresca estado/log de operaciones encoladas y dispara el upsert del censo. -->
    <record id="cron_db_operation_refresh" model="ir.cron">
        <field name="name">Despacho: refrescar operaciones de BD</field>
        <field name="model_id" ref="model_despacho_db_operation"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Censo automático de TODOS los servidores (action_scan_server recorre SERVER_KEYS
         y encola un censo por cada uno; read-only, los remotos por SSH).

         ACTIVO desde 19.0.1.61.0: sin él, la ficha de cada BD (pestaña Respaldos,
         último respaldo, off-site, usuarios, apps) solo se refrescaba al pulsar
         "Escanear servidor" a mano, y el tablero se quedaba congelado semanas
         mostrando respaldos "de hace días" aunque el nocturno corriera perfecto
         (falsa alarma real del 2026-07-30: censo del 07-06, respaldos al día).

         nextcall = 12:00 UTC = 06:00 Morelia (el server corre en TZ local pero
         ir.cron guarda/agenda en UTC; México ya no usa horario de verano, así que
         no hay deriva). A esa hora YA terminaron los dos nocturnos: odoo19 04:30→~05:11
         y odoo18 03:30→~03:38 hora de Morelia. -->
    <record id="cron_db_census" model="ir.cron">
        <field name="name">Despacho: escanear servidor (censo de BDs)</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="state">code</field>
        <field name="code">model.action_scan_server()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Convierte automáticamente los Pendientes (To-do) etiquetados por cliente en
         Tareas del proyecto de cada BD. Reemplaza el botón manual: el método es
         idempotente y repetible (solo toca los to-dos con UNA sola BD; arrastra los
         nuevos). Diario. -->
    <record id="cron_convert_todos_to_tasks" model="ir.cron">
        <field name="name">Despacho: convertir Pendientes (To-do) en Tareas</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="state">code</field>
        <field name="code">model.action_convert_todos_to_tasks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Ciclo de vida BD↔suscripción: si la suscripción ligada a una BD se
         canceló/venció (churn) desmonta los puentes MCP activos y SUSPENDE el sitio
         web (503 con certificado intacto). Si vuelve a estar al corriente, REACTIVA
         el sitio que se suspendió por churn (el MCP se reactiva a mano). Cuando un
         cliente deja de pagar pierde el servicio sin intervención manual. -->
    <record id="cron_suspend_mcp_churned" model="ir.cron">
        <field name="name">Despacho: ciclo de vida de suscripciones (MCP + sitio)</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="state">code</field>
        <field name="code">model._cron_lifecycle_subscriptions()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <!-- Conciliación de Analitix: sucursales midiendo sin cobro activo.
         Levanta una actividad, nunca una acción — el addon del cliente no
         lleva interruptor remoto y no debe llevarlo. -->
    <record id="cron_analitix_drift" model="ir.cron">
        <field name="name">Despacho: conciliar sucursales de Analitix</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model._cron_analitix_drift()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
