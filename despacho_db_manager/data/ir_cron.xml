<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Refresca estado/log de operaciones encoladas y dispara el upsert del censo. -->
    <record id="cron_db_operation_refresh" model="ir.cron">
        <field name="name">Despacho: refrescar operaciones de BD</field>
        <field name="model_id" ref="model_despacho_db_operation"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Censo automático del servidor. DESACTIVADO por defecto (opt-in). -->
    <record id="cron_db_census" model="ir.cron">
        <field name="name">Despacho: escanear servidor (censo de BDs)</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="state">code</field>
        <field name="code">model.action_scan_server()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>

    <!-- Convierte automáticamente los Pendientes (To-do) etiquetados por cliente en
         Tareas del proyecto de cada BD. Reemplaza el botón manual: el método es
         idempotente y repetible (solo toca los to-dos con UNA sola BD; arrastra los
         nuevos). Diario. -->
    <record id="cron_convert_todos_to_tasks" model="ir.cron">
        <field name="name">Despacho: convertir Pendientes (To-do) en Tareas</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="state">code</field>
        <field name="code">model.action_convert_todos_to_tasks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Corte automático del puente MCP: si la suscripción ligada a una BD se
         canceló/venció (churn) y la BD aún tiene puentes MCP activos, los desmonta
         (reusa mcp_remove). Cuando un cliente deja de pagar, su IA pierde acceso. -->
    <record id="cron_suspend_mcp_churned" model="ir.cron">
        <field name="name">Despacho: suspender MCP de suscripciones canceladas</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="state">code</field>
        <field name="code">model._cron_suspend_mcp_for_churned()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
