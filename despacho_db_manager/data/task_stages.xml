<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Etapas de tareas para las BDs del despacho (kanban del smart button
         "Tareas"). Se ligan a cada proyecto-BD en el censo/alta
         (_despacho_ensure_task_stages). noupdate: el usuario puede renombrarlas
         o reordenarlas sin que un -u se las pise. Solo "Hecho" va plegada. -->
    <data noupdate="1">
        <record id="stage_task_pendiente" model="project.task.type">
            <field name="name">Pendiente</field>
            <field name="sequence">10</field>
            <field name="fold" eval="False"/>
        </record>
        <record id="stage_task_en_curso" model="project.task.type">
            <field name="name">En curso</field>
            <field name="sequence">20</field>
            <field name="fold" eval="False"/>
        </record>
        <record id="stage_task_espera" model="project.task.type">
            <field name="name">En espera (cliente)</field>
            <field name="sequence">30</field>
            <field name="fold" eval="False"/>
        </record>
        <record id="stage_task_hecho" model="project.task.type">
            <field name="name">Hecho</field>
            <field name="sequence">40</field>
            <field name="fold" eval="True"/>
        </record>
    </data>
</odoo>
