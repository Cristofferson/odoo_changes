<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_db_operation_form" model="ir.ui.view">
        <field name="name">despacho.db.operation.form</field>
        <field name="model">despacho.db.operation</field>
        <field name="arch" type="xml">
            <form string="Operación de BD">
                <header>
                    <button name="action_provision" type="object" string="Ejecutar"
                            class="oe_highlight"
                            invisible="state not in ('draft','done','error')"/>
                    <button name="action_refresh" type="object" string="Actualizar estado"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,queued,running,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="op"/>
                        <field name="project_id"
                               invisible="op in ('alta','census')"
                               required="op in ('baja','refresh','crear_test','mcp_add','mcp_remove')"
                               readonly="op in ('baja','refresh','crear_test','mcp_add','mcp_remove') and context.get('default_project_id')"/>
                        <field name="simulate" invisible="op in ('mcp_add','mcp_remove')"/>
                    </group>
                    <!-- ALTA -->
                    <group string="Nuevo cliente" invisible="op != 'alta'">
                        <group>
                            <field name="db_name" placeholder="cafemiranda"
                                   required="op == 'alta'"/>
                            <field name="domain" placeholder="cafemiranda.com"
                                   required="op == 'alta'"/>
                            <field name="mail_domain" placeholder="(opcional) cafemiranda.com"/>
                            <field name="modules" required="op == 'alta'"/>
                        </group>
                        <group>
                            <field name="with_dns"/>
                            <field name="with_ssl"/>
                            <field name="with_mail"/>
                            <field name="wants_cfdi"/>
                        </group>
                    </group>
                    <!-- BAJA -->
                    <group string="Baja de cliente" invisible="op != 'baja'">
                        <div class="alert alert-warning" role="alert" colspan="2"
                             invisible="op != 'baja'">
                            Por defecto la baja SOLO respalda y deshabilita el sitio (reversible).
                            Deja "Simular" activado para ver el plan; desactívalo y vuelve a Ejecutar para aplicar.
                        </div>
                        <field name="do_drop"/>
                        <field name="confirm_name"
                               invisible="not do_drop"
                               required="do_drop and not simulate"
                               placeholder="escribe el nombre exacto de la BD"/>
                    </group>
                    <!-- REFRESH -->
                    <group string="Refrescar BD de prueba" invisible="op != 'refresh'">
                        <div class="alert alert-danger" role="alert" colspan="2"
                             invisible="op != 'refresh'">
                            SOBRESCRIBE la BD de prueba con una copia de producción y la NEUTRALIZA
                            (sin correo ni CFDI reales). Deja "Simular" para ver el plan; desactívalo
                            y escribe el nombre del destino en "Confirmar" para aplicar.
                        </div>
                        <field name="dest_server" invisible="1"/>
                        <field name="source_project_id" required="op == 'refresh'"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="confirm_name"
                               invisible="op == 'refresh' and simulate"
                               required="op == 'refresh' and not simulate"
                               placeholder="escribe el nombre del destino (BD de prueba)"/>
                    </group>
                    <!-- CREAR BD DE PRUEBA -->
                    <group string="Crear BD de prueba" invisible="op != 'crear_test'">
                        <div class="alert alert-warning" role="alert" colspan="2"
                             invisible="op != 'crear_test'">
                            Crea una BD de prueba como copia EXACTA de la BD de origen
                            (la de arriba) y la NEUTRALIZA (sin correo ni CFDI reales).
                            Si el nombre ya existe, lo sobrescribe. Deja "Simular" para
                            ver el plan; desactívalo y escribe el nombre en "Confirmar"
                            para aplicar.
                        </div>
                        <field name="new_test_db" required="op == 'crear_test'"
                               placeholder="nombre nuevo, ej. testnovadiam"/>
                        <field name="crear_test_overwrite"/>
                        <div class="alert alert-warning" role="alert" colspan="2"
                             invisible="op != 'crear_test' or not crear_test_overwrite">
                            ⚠️ Con "Sobrescribir" activado, si ya existe una BD con ese
                            nombre será ELIMINADA y reemplazada. Úsalo solo a propósito.
                        </div>
                        <field name="confirm_name"
                               invisible="op == 'crear_test' and simulate"
                               required="op == 'crear_test' and not simulate"
                               placeholder="escribe el nombre de la nueva BD de prueba"/>
                    </group>
                    <!-- CENSO -->
                    <group string="Escaneo" invisible="op != 'census'">
                        <field name="target_server"/>
                        <field name="with_modules"/>
                    </group>
                    <!-- ACTIVAR MCP -->
                    <group string="Activar puente MCP" invisible="op != 'mcp_add'">
                        <div class="alert alert-info" role="alert" colspan="2"
                             invisible="op != 'mcp_add'">
                            Activa un endpoint para que la IA del cliente (Claude, ChatGPT,
                            Gemini) consulte ESTA base de datos en <b>solo lectura</b>. Al
                            terminar verás el endpoint y el <b>token UNA sola vez</b>: cópialo
                            para entregárselo al cliente.
                        </div>
                        <field name="mcp_slug" required="op == 'mcp_add'"
                               placeholder="ej. lamur"/>
                        <field name="mcp_writes"/>
                        <div class="alert alert-warning" role="alert" colspan="2"
                             invisible="not mcp_writes">
                            ⚠️ Con escrituras activadas, la IA podrá CREAR/MODIFICAR datos
                            en el Odoo del cliente. Úsalo solo si es estrictamente necesario.
                        </div>
                    </group>
                    <!-- DESACTIVAR MCP -->
                    <group string="Desactivar puente MCP" invisible="op != 'mcp_remove'">
                        <div class="alert alert-warning" role="alert" colspan="2"
                             invisible="op != 'mcp_remove'">
                            Detiene y elimina el puente MCP de esta base. La IA del cliente
                            dejará de tener acceso de inmediato.
                        </div>
                        <field name="mcp_slug" readonly="1"/>
                        <field name="mcp_purge_key"/>
                    </group>
                    <notebook>
                        <page string="Registro">
                            <field name="log" widget="text" readonly="1" nolabel="1"
                                   class="font-monospace w-100"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_db_operation_list" model="ir.ui.view">
        <field name="name">despacho.db.operation.list</field>
        <field name="model">despacho.db.operation</field>
        <field name="arch" type="xml">
            <list string="Operaciones">
                <field name="create_date"/>
                <field name="op"/>
                <field name="display_name" string="Objetivo"/>
                <field name="simulate"/>
                <field name="state"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-info="state in ('queued','running')"/>
            </list>
        </field>
    </record>

    <!-- Alta: abre directo el formulario de una nueva operación tipo alta -->
    <record id="action_db_operation_alta" model="ir.actions.act_window">
        <field name="name">Provisionar cliente</field>
        <field name="res_model">despacho.db.operation</field>
        <field name="view_mode">form,list</field>
        <field name="target">current</field>
        <field name="context">{'default_op': 'alta', 'form_view_initial_mode': 'edit'}</field>
    </record>

    <!-- Historial de todas las operaciones -->
    <record id="action_db_operation_all" model="ir.actions.act_window">
        <field name="name">Operaciones de BD</field>
        <field name="res_model">despacho.db.operation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_db_operation_alta" name="Provisionar cliente"
              parent="databases.menu_main_databases"
              action="action_db_operation_alta" sequence="15"/>
    <menuitem id="menu_db_operation_all" name="Operaciones"
              parent="databases.menu_main_databases"
              action="action_db_operation_all" sequence="25"/>
</odoo>
