<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_db_operation_form" model="ir.ui.view">
        <field name="name">despacho.db.operation.form</field>
        <field name="model">despacho.db.operation</field>
        <field name="arch" type="xml">
            <form string="Operación de BD">
                <header>
                    <button name="action_provision" type="object" string="Ejecutar"
                            class="oe_highlight"
                            invisible="state not in ('draft','done','error')"/>
                    <button name="action_refresh" type="object" string="Actualizar estado"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,queued,running,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="op"/>
                        <field name="project_id"
                               invisible="op in ('alta','census')"/>
                        <field name="simulate"/>
                    </group>
                    <!-- ALTA -->
                    <group string="Nuevo cliente" invisible="op != 'alta'">
                        <group>
                            <field name="db_name" placeholder="cafemiranda"
                                   required="op == 'alta'"/>
                            <field name="domain" placeholder="cafemiranda.com"
                                   required="op == 'alta'"/>
                            <field name="mail_domain" placeholder="(opcional) cafemiranda.com"/>
                            <field name="modules" required="op == 'alta'"/>
                        </group>
                        <group>
                            <field name="with_dns"/>
                            <field name="with_ssl"/>
                            <field name="with_mail"/>
                            <field name="wants_cfdi"/>
                        </group>
                    </group>
                    <!-- CENSO -->
                    <group string="Escaneo" invisible="op != 'census'">
                        <field name="with_modules"/>
                    </group>
                    <notebook>
                        <page string="Registro">
                            <field name="log" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_db_operation_list" model="ir.ui.view">
        <field name="name">despacho.db.operation.list</field>
        <field name="model">despacho.db.operation</field>
        <field name="arch" type="xml">
            <list string="Operaciones">
                <field name="create_date"/>
                <field name="op"/>
                <field name="display_name" string="Objetivo"/>
                <field name="simulate"/>
                <field name="state"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-info="state in ('queued','running')"/>
            </list>
        </field>
    </record>

    <!-- Alta: abre directo el formulario de una nueva operación tipo alta -->
    <record id="action_db_operation_alta" model="ir.actions.act_window">
        <field name="name">Provisionar cliente</field>
        <field name="res_model">despacho.db.operation</field>
        <field name="view_mode">form,list</field>
        <field name="target">current</field>
        <field name="context">{'default_op': 'alta', 'form_view_initial_mode': 'edit'}</field>
    </record>

    <!-- Historial de todas las operaciones -->
    <record id="action_db_operation_all" model="ir.actions.act_window">
        <field name="name">Operaciones de BD</field>
        <field name="res_model">despacho.db.operation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_db_operation_alta" name="Provisionar cliente"
              parent="databases.menu_main_databases"
              action="action_db_operation_alta" sequence="15"/>
    <menuitem id="menu_db_operation_all" name="Operaciones"
              parent="databases.menu_main_databases"
              action="action_db_operation_all" sequence="25"/>
</odoo>
