<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción servidor para el botón "Escanear servidor" del listado -->
    <record id="action_scan_server" model="ir.actions.server">
        <field name="name">Escanear servidor</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="group_ids" eval="[Command.link(ref('databases.group_databases_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_scan_server()</field>
    </record>

    <!-- Botón en la cabecera del listado nativo de Databases -->
    <record id="view_databases_list_scan" model="ir.ui.view">
        <field name="name">databases.project.list.scan</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="databases.view_databases_list"/>
        <field name="arch" type="xml">
            <!-- Al clic en una fila abrir la ficha de AJUSTES (info del censo: Servidor,
                 Respaldos, Apps…) en vez del tablero de TAREAS del proyecto, que aquí no
                 se usa. La lista nativa trae action="action_view_tasks"; lo cambiamos. -->
            <list position="attributes">
                <attribute name="action">action_open_self</attribute>
                <!-- "Nuevo" crea un project.project a mano: aquí no aplica (las BDs
                     entran por censo/alta). Se desactiva el alta manual. -->
                <attribute name="create">0</attribute>
            </list>
            <header position="inside">
                <button name="%(action_scan_server)d" type="action" string="Escanear servidor"
                        display="always" groups="databases.group_databases_manager"/>
                <button name="action_convert_todos_to_tasks" type="object"
                        string="Convertir pendientes → tareas" display="always"
                        groups="databases.group_databases_manager"
                        help="Convierte los Pendientes (To-do) etiquetados por cliente en tareas del proyecto de cada BD, para que aparezcan en Tareas."/>
            </header>
            <!-- El botón "Conectar" nativo (action_database_connect, ya overridden a
                 auto-login) solo se mostraba si el operador era usuario de esa BD
                 (database_can_access). Lo hacemos visible para TODA BD del inventario
                 (un solo botón: usamos el nativo, no agregamos otro). -->
            <button name="action_database_connect" position="attributes">
                <attribute name="invisible">not database_hosting</attribute>
            </button>
            <field name="database_last_synchro" position="after">
                <field name="despacho_user_count" optional="show" string="Usuarios"/>
                <field name="despacho_size_display" optional="show" string="Tamaño"/>
                <field name="despacho_last_backup" optional="hide" string="Último respaldo"/>
                <field name="despacho_backup_count" optional="hide" string="Nº respaldos"/>
                <field name="despacho_autologin_user" optional="show" string="Conectar como"/>
            </field>
            <!-- El botón "Conectar" va hasta el final, JUSTO DESPUÉS de
                 "Conectar como" (última columna a la derecha). -->
            <xpath expr="//field[@name='despacho_autologin_user']" position="after">
                <button name="action_database_connect" position="move"/>
            </xpath>
            <!-- Versión nativa (database_version): vacía en premise; el censo la
                 llena con la versión del módulo base. La mostramos por defecto. -->
            <field name="database_version" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <!-- La columna nativa de usuarios (database_nb_users) no se alimenta en
                 este montaje premise (queda en 0): la ocultamos para no duplicar con
                 "Usuarios" (despacho_user_count), que sí trae datos del censo. -->
            <field name="database_nb_users" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <!-- "Sincronizar" nativo requiere API por BD (Odoo.sh); en premise falla.
                 Nuestro equivalente es "Escanear servidor" (censo). Se oculta. -->
            <button name="databases.action_synchronize_all_databases" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <!-- Botón "Ajustes" (action_open_self) de la fila: redundante ahora que el
                 clic en la fila ya abre la ficha de Ajustes. Se oculta. -->
            <button name="action_open_self" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
        </field>
    </record>

    <!-- Ocultar el botón "Sincronizar" del formulario nativo (mismo motivo). -->
    <record id="edit_project_databases_hide_sync" model="ir.ui.view">
        <field name="name">despacho.databases.form.hide.sync</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="databases.edit_project"/>
        <field name="arch" type="xml">
            <button name="action_database_synchronize" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <!-- "Nuevo" no aplica en Databases (las BDs entran por censo/alta).
                 Seguro hacerlo aquí: databases.edit_project es el form de Databases,
                 NO el form global de Proyectos. -->
            <form position="attributes">
                <attribute name="create">0</attribute>
            </form>
            <!-- Botón "Conectar" por usuario en Gestión de usuarios: inicia sesión
                 COMO ese usuario concreto de la BD (no solo el admin). Va al final
                 (última posición a la derecha), tras el botón de quitar usuario. -->
            <xpath expr="//field[@name='database_user_ids']/list/button[@name='action_remove_users']" position="after">
                <button name="action_autologin_as_user" type="object" string="Conectar"
                        icon="fa-sign-in" groups="databases.group_databases_manager"/>
            </xpath>
        </field>
    </record>

    <!-- Pestaña "Servidor" + smart button en el formulario de la BD -->
    <record id="edit_project_despacho" model="ir.ui.view">
        <field name="name">despacho.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!-- Botón "Conectar" (entra logueado) en el encabezado. Invisible sin
                 database_hosting → no aparece en proyectos normales de la app Proyecto.
                 (NO tocar `create` aquí: project.edit_project es el form global de
                 Proyectos; desactivar Nuevo se hace solo en el form de Databases.) -->
            <header position="inside">
                <button name="action_database_connect" type="object" string="Conectar"
                        class="btn-primary" icon="fa-sign-in"
                        invisible="not database_hosting"
                        groups="databases.group_databases_manager"/>
            </header>
            <div name="button_box" position="inside">
                <button class="oe_stat_button" icon="fa-tasks" type="object"
                        name="action_view_operations"
                        invisible="not database_hosting"
                        groups="databases.group_databases_manager">
                    <field name="despacho_operation_count" widget="statinfo" string="Operaciones"/>
                </button>
            </div>
            <notebook position="inside">
                <page name="despacho_server" string="Servidor"
                      invisible="not database_hosting"
                      groups="databases.group_databases_manager">
                    <field name="despacho_is_test" invisible="1"/>
                    <div class="oe_button_box" name="despacho_baja_box">
                        <button name="action_respaldo" type="object" string="Respaldar ahora"
                                class="btn-secondary" icon="fa-download"/>
                        <button name="action_refresh_test" type="object" string="Refrescar desde prod"
                                class="btn-warning" icon="fa-refresh"
                                invisible="not despacho_is_test"
                                confirm="Vas a refrescar esta BD de prueba desde producción (la sobrescribe). Se abrirá el asistente en modo simulación. ¿Continuar?"/>
                        <button name="action_create_test" type="object" string="Crear BD de prueba"
                                class="btn-info" icon="fa-flask"
                                invisible="despacho_is_test"
                                confirm="Vas a crear una BD de prueba como copia de ESTA BD de producción. Se abrirá el asistente en modo simulación. ¿Continuar?"/>
                        <button name="action_baja" type="object" string="Dar de baja"
                                class="btn-danger" icon="fa-trash"
                                confirm="Vas a iniciar la BAJA de esta base de datos. Se abrirá el asistente en modo simulación. ¿Continuar?"/>
                    </div>
                    <group string="Notas">
                        <field name="description" nolabel="1"
                               placeholder="Notas internas de esta BD: contacto, particularidades, pendientes, accesos…"/>
                    </group>
                    <group>
                        <group string="Inventario">
                            <field name="despacho_db_local"/>
                            <field name="despacho_server"/>
                            <field name="despacho_provision_state"/>
                            <field name="despacho_size_display"/>
                            <label for="despacho_user_count" string="Usuarios (internos / total)"/>
                            <div>
                                <field name="despacho_user_count" class="oe_inline"/> /
                                <field name="despacho_user_total" class="oe_inline"/>
                            </div>
                        </group>
                        <group string="Censo">
                            <field name="despacho_last_census"/>
                            <field name="despacho_last_backup"/>
                            <field name="despacho_autologin_ready" readonly="1"/>
                            <field name="despacho_autologin_user" readonly="1"
                                   invisible="not despacho_autologin_ready"/>
                            <field name="despacho_todo_tag_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Apps custom">
                        <field name="despacho_custom_module_count"/>
                    </group>
                    <field name="despacho_module_ids" nolabel="1" readonly="1">
                        <list string="Apps custom" create="0" edit="0" delete="0">
                            <field name="name" string="Técnico"/>
                            <field name="shortdesc" string="Nombre"/>
                            <field name="summary" string="Descripción" optional="show"/>
                            <field name="author" string="Autor" optional="show"/>
                            <field name="installed_version" string="Versión"/>
                            <field name="application" string="App" widget="boolean" optional="hide"/>
                            <field name="license" string="Licencia" optional="hide"/>
                            <field name="app_store" string="apps.odoo.com" widget="badge"
                                   decoration-success="app_store == 'yes'"
                                   decoration-muted="app_store == 'unknown'"
                                   decoration-warning="app_store == 'no'"/>
                            <field name="app_store_url" string="Enlace" widget="url"
                                   text="Ver" optional="show"/>
                            <field name="installed_since" string="Alta" optional="show"/>
                            <field name="updated" string="Actualizado" optional="hide"/>
                            <field name="website" string="Sitio" widget="url" optional="hide"/>
                        </list>
                    </field>
                    <separator string="Módulos instalados (todos)"/>
                    <field name="despacho_installed_module_ids" nolabel="1" readonly="1">
                        <list string="Módulos instalados" create="0" edit="0" delete="0">
                            <field name="name" string="Técnico"/>
                            <field name="shortdesc" string="Nombre"/>
                            <field name="installed_version" string="Versión"/>
                            <field name="application" string="App" widget="boolean" optional="show"/>
                        </list>
                    </field>
                </page>
                <page name="despacho_backups" string="Respaldos"
                      invisible="not database_hosting"
                      groups="databases.group_databases_manager">
                    <div class="alert alert-info" role="alert">
                        Respaldos <b>automáticos</b> (nocturnos) detectados por el censo. La
                        retención larga (p.ej. 30 días) vive <b>off-site</b> en la nube; el
                        <b>disco local</b> del servidor suele conservar pocos días a propósito.
                    </div>
                    <group string="Destinos off-site (nube)">
                        <field name="despacho_offsite_ids" nolabel="1" readonly="1">
                            <list string="Destinos off-site" create="0" edit="0" delete="0">
                                <field name="remote" string="Destino"/>
                                <field name="available" string="Verificable" widget="boolean"/>
                                <field name="retention_days" string="Días en la nube"/>
                                <field name="date_oldest" string="Más antiguo"/>
                                <field name="date_newest" string="Más reciente"/>
                                <field name="has_latest" string="Última copia presente" widget="boolean"/>
                            </list>
                        </field>
                    </group>
                    <group string="En este servidor (disco local)">
                        <group>
                            <field name="despacho_backup_count" string="Días en disco local"/>
                            <field name="despacho_backup_total_display" string="Tamaño en disco"/>
                        </group>
                        <group>
                            <field name="despacho_last_backup"/>
                            <field name="despacho_backup_oldest" string="Más antiguo en disco"/>
                        </group>
                    </group>
                    <field name="despacho_backup_ids" nolabel="1" readonly="1">
                        <list string="Respaldos en disco local" default_order="backup_date desc">
                            <field name="backup_date"/>
                            <field name="name"/>
                            <field name="size_display" string="Tamaño"/>
                            <field name="backup_size" column_invisible="1"/>
                            <field name="checksum_ok" string="Integridad" widget="boolean"/>
                            <field name="server" optional="hide"/>
                            <field name="path" optional="hide"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- "Reportes" del app Bases de datos = menú nativo de Proyecto heredado
         (databases.menu_reporting), apunta a la misma acción que "Tareas" y queda
         vacío/sin uso aquí. Se oculta. -->
    <record id="databases.menu_reporting" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
