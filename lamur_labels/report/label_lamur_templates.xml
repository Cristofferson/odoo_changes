<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Diseno de etiqueta mariposa de LAMUR (recuperado de la instalacion
             en Odoo 17, donde vivia como modificacion directa de la vista
             stock.label_product_product_view y se perdio en la migracion a 19).

             Fisicamente: 711 x 136 dots @ 203 dpi = 89 x 17 mm.
             La plantilla maestra stock.label_product_product_view ya abre con
             ^XA^CI28 y cierra con ^XZ, por eso este bloque cierra la seccion de
             configuracion con su propio ^XZ y vuelve a abrir con ^XA. -->
        <template id="lamur_zpl_label">
            <t t-translation="off">
~TA000
~JSN
^LT0
^MNW
^MTT
^PON
^PMN
^LH0,0
^JMA
^PR2,6
~SD25
^JUS
^LRN
^CI27
^PA0,1,1,0
^XZ
^XA
^MMT
^PW711
^LL136
^LS0
^FT5,108
^FB155,5,0^A0N,20,21^FH\^CI28^FD<t t-out="product_info['display_name_markup']"/>^FS
<t t-if="price_included">
^FT210,105^A0B,35,30^FH\^CI28^FD<t t-esc="currency_id.symbol"/><t t-esc="pricelist._get_product_price(product, 1, currency=currency_id)" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 0}"/>^FS^CI27  
</t>
<t t-if="barcode">
^BY1,3,31^FT501,94^BCN,,Y,N
^FH\^FD<t t-out="barcode"/>^FS
</t>
<t t-else="">
^BY1,3,31^FT501,94^BCN,,Y,N
^FH\^FD<t t-out="product_info['default_code'][0]"/>^FS 
</t>
^FO495,14^GFA,685,1012,23,:Z64::28EB
<t t-set="lamur_tmpl_id" t-value="product.id if product._name == 'product.template' else product.product_tmpl_id.id"/>
<t t-set="lamur_site" t-value="(product.env['website'].sudo().search([('company_id', '=', product.company_id.id)], limit=1).domain or product.env['ir.config_parameter'].sudo().get_param('web.base.url') or '').rstrip('/')"/>
^FT370,110,2^BQN,2,3
^FH\^FDLA,<t t-out="lamur_site"/>/shop/<t t-out="lamur_tmpl_id"/>^FS
^FO241,1^GFA,749,3488,32,:Z64::D43B
            </t>
        </template>

        <!-- Engancha el diseno al desplegable "Plantilla ZPL" sin tocar las
             cuatro plantillas nativas de Odoo. -->
        <template id="label_product_product_view_lamur"
                  inherit_id="stock.label_product_product_view">
            <xpath expr="//t[@t-call='stock.jewelry_zpl_label']" position="after">
                <t t-elif="'lamur' in zpl_template" t-call="lamur_labels.lamur_zpl_label"/>
            </xpath>
        </template>

    </data>
</odoo>
