<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Odoo 19 ir.cron schema:
              - Removed: numbercall, doall, nextcall (handled automatically).
              - Kept:    name, model_id, state, code, interval_number,
                         interval_type, user_id, active.
            See https://github.com/odoo/odoo/blob/19.0/odoo/addons/base/models/ir_cron.py
        -->
        <record id="ir_cron_special_dates" model="ir.cron">
            <field name="name">Special Dates: Send Daily Reminders</field>
            <field name="model_id" ref="model_xb_wish_reminders"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_date_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
