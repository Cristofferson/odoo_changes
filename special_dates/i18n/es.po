#. module: special_dates
#: model:mail.template,body_html:special_dates.email_template_special_date_default
msgid ""
"<div style=\"margin:0;padding:0;background:#f4f6fb;\">\n"
"  <div style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;               box-shadow:0 4px 24px rgba(0,0,0,.06);overflow:hidden;               font-family:'Helvetica Neue',Arial,sans-serif;color:#2b2b2b;\">\n"
"    <div style=\"background:linear-gradient(135deg,#714B67 0%,#017E84 100%);                 padding:32px 24px;text-align:center;color:#fff;\">\n"
"      <div style=\"font-size:48px;line-height:1;margin-bottom:8px;\">🎉</div>\n"
"      <h1 style=\"margin:0;font-size:24px;font-weight:600;letter-spacing:.5px;\">\n"
"        <t t-out=\"object.wish_type.name or 'A special date'\"/>\n"
"      </h1>\n"
"    </div>\n"
"    <div style=\"padding:32px 28px;font-size:15px;line-height:1.6;\">\n"
"      <p style=\"margin:0 0 16px 0;\">\n"
"        Dear <strong t-out=\"object.partner_id.name or ''\"/>,\n"
"      </p>\n"
"      <p style=\"margin:0 0 16px 0;\">\n"
"        On this special day, we want to take a moment to send you our warmest\n"
"        wishes. Thank you for being part of our story — we hope your day is\n"
"        filled with joy and the year ahead with success.\n"
"      </p>\n"
"      <p style=\"margin:0 0 24px 0;\">\n"
"        With appreciation,<br/>\n"
"        <strong t-out=\"object.company_id.name or user.company_id.name\"/>\n"
"      </p>\n"
"      <hr style=\"border:none;border-top:1px solid #eee;margin:24px 0;\"/>\n"
"      <p style=\"margin:0;font-size:12px;color:#888;text-align:center;\">\n"
"        This message was sent automatically by Special Dates.\n"
"      </p>\n"
"    </div>\n"
"  </div>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:0;background:#f4f6fb;\">\n"
"  <div style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;               box-shadow:0 4px 24px rgba(0,0,0,.06);overflow:hidden;               font-family:'Helvetica Neue',Arial,sans-serif;color:#2b2b2b;\">\n"
"    <div style=\"background:linear-gradient(135deg,#714B67 0%,#017E84 100%);                 padding:32px 24px;text-align:center;color:#fff;\">\n"
"      <div style=\"font-size:48px;line-height:1;margin-bottom:8px;\">🎉</div>\n"
"      <h1 style=\"margin:0;font-size:24px;font-weight:600;letter-spacing:.5px;\">\n"
"        <t t-out=\"object.wish_type.name or 'Una fecha especial'\"/>\n"
"      </h1>\n"
"    </div>\n"
"    <div style=\"padding:32px 28px;font-size:15px;line-height:1.6;\">\n"
"      <p style=\"margin:0 0 16px 0;\">\n"
"        Estimado/a <strong t-out=\"object.partner_id.name or ''\"/>,\n"
"      </p>\n"
"      <p style=\"margin:0 0 16px 0;\">\n"
"        En este día tan especial, queremos tomarnos un momento para enviarte nuestros\n"
"        mejores deseos. Gracias por ser parte de nuestra historia — esperamos que tu día\n"
"        esté lleno de alegría y el año por venir lleno de éxitos.\n"
"      </p>\n"
"      <p style=\"margin:0 0 24px 0;\">\n"
"        Con aprecio,<br/>\n"
"        <strong t-out=\"object.company_id.name or user.company_id.name\"/>\n"
"      </p>\n"
"      <hr style=\"border:none;border-top:1px solid #eee;margin:24px 0;\"/>\n"
"      <p style=\"margin:0;font-size:12px;color:#888;text-align:center;\">\n"
"        Este mensaje fue enviado automáticamente por Fechas Especiales.\n"
"      </p>\n"
"    </div>\n"
"  </div>\n"
"</div>\n"
"            "

