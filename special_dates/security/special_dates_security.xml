<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Odoo 19 security model:
            - res.groups.category_id was replaced by privilege_id (M2O to res.groups.privilege).
            - res.groups.users  was renamed to user_ids.
            We still need an ir.module.category for the app-selector UI;
            the privilege links the groups to that category.
        -->

        <record id="module_category_special_dates" model="ir.module.category">
            <field name="name">Special Dates</field>
            <field name="description">Manage customer birthdays and special date reminders.</field>
            <field name="sequence">25</field>
        </record>

        <record id="res_groups_privilege_special_dates" model="res.groups.privilege">
            <field name="name">Special Dates</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_special_dates"/>
        </record>

        <record id="group_special_dates_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_special_dates"/>
            <field name="comment">Can read and create reminders for customers.</field>
        </record>

        <record id="group_special_dates_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_special_dates"/>
            <field name="implied_ids" eval="[(4, ref('group_special_dates_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full access: configure reminder types, mail templates, and the daily cron.</field>
        </record>

        <!-- Multi-company record rules -->
        <record id="xb_wish_reminders_company_rule" model="ir.rule">
            <field name="name">Special Dates: Multi-Company</field>
            <field name="model_id" ref="model_xb_wish_reminders"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="xb_wish_reminders_today_company_rule" model="ir.rule">
            <field name="name">Today's Special Dates: Multi-Company</field>
            <field name="model_id" ref="model_xb_wish_reminders_today"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
