<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="special_dates.TodayRemindersPopup">
        <Dialog title="title" size="'lg'">
            <div class="xb-today-popup">
                <t t-if="props.count > 0">
                    <div class="xb-today-search mb-3">
                        <input type="text"
                               class="form-control"
                               placeholder="Search customer..."
                               t-model="state.search"/>
                    </div>
                    <div class="xb-today-list">
                        <t t-foreach="filteredItems" t-as="item" t-key="item.partner_id">
                            <div class="xb-today-item">
                                <img class="xb-today-avatar"
                                     t-att-src="item.image_128"
                                     alt=""/>
                                <div class="xb-today-info">
                                    <div class="xb-today-name">
                                        <t t-esc="item.partner_name"/>
                                    </div>
                                    <div class="xb-today-reasons">
                                        <t t-foreach="item.reminders" t-as="r" t-key="r.id">
                                            <span class="xb-today-chip">
                                                <span class="xb-today-chip-icon"><t t-esc="r.icon"/></span>
                                                <span class="xb-today-chip-name"><t t-esc="r.wish_type_name"/></span>
                                            </span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center p-4">
                        <p>No customers have a special date today.</p>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onClose">
                    Close
                </button>
            </t>
        </Dialog>
    </t>

</templates>
