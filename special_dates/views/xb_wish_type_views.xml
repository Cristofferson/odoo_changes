<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="xb_wish_type_view_form" model="ir.ui.view">
        <field name="name">xb.wish.type.form</field>
        <field name="model">xb.wish.type</field>
        <field name="arch" type="xml">
            <form string="Reminder Type">
                <header>
                    <button name="action_run_now"
                            type="object"
                            string="Run Daily Cron Now"
                            class="btn-primary"
                            confirm="This will process all due reminders right now (emails, SMS, activities). Continue?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Birthday"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="icon"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="period_type"/>
                            <field name="day_type" string="Default Day"
                                   invisible="period_type != 'day'"
                                   required="period_type == 'day'"/>
                            <field name="no_of_day" string="Default Days"
                                   invisible="period_type != 'no_of_day'"
                                   required="period_type == 'no_of_day'"/>
                            <field name="date" invisible="period_type != 'year'"/>
                            <field name="show_in_pos"/>
                            <field name="xb_pos_auto_capture"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Communications" name="communications">
                            <p class="text-muted">Add one line per message you want to send. Pick the channel (Email, SMS, WhatsApp if installed), the number of days before/after the date, and the template.</p>
                            <field name="schedule_ids"
                                   context="{'default_wish_type_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="channel"/>
                                    <field name="interval_nbr"
                                           invisible="interval_unit == 'now'"/>
                                    <field name="interval_unit"/>
                                    <field name="interval_type"
                                           invisible="interval_unit == 'now'"/>
                                    <field name="mail_template_id"
                                           invisible="channel != 'mail'"
                                           required="channel == 'mail'"
                                           options="{'no_create_edit': True}"/>
                                    <field name="sms_template_id"
                                           invisible="channel != 'sms'"
                                           required="channel == 'sms'"
                                           options="{'no_create_edit': True}"/>
                                    <field name="last_sent" optional="hide"/>
                                    <field name="sent_count" string="# Sent"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Auto-Activities" name="activities">
                            <p class="text-muted">Activities scheduled on the customer the day of the event (or N days before/after). The responsible user receives the notification in their Activities dashboard.</p>
                            <field name="activity_ids"
                                   context="{'default_wish_type_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="activity_type_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="summary"/>
                                    <field name="delay_direction"/>
                                    <field name="delay_count"
                                           invisible="delay_direction == 'on'"/>
                                    <field name="user_field"/>
                                    <field name="user_id"
                                           invisible="user_field != 'fixed'"
                                           required="user_field == 'fixed'"
                                           options="{'no_create_edit': True}"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="xb_wish_type_view_list" model="ir.ui.view">
        <field name="name">xb.wish.type.list</field>
        <field name="model">xb.wish.type</field>
        <field name="arch" type="xml">
            <list sample="1" string="Reminder Types">
                <field name="name"/>
                <field name="icon"/>
                <field name="period_type"/>
                <field name="schedule_count" string="Channels"/>
                <field name="activity_count" string="Activities"/>
                <field name="show_in_pos" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="xb_wish_type_view_search" model="ir.ui.view">
        <field name="name">xb.wish.type.search</field>
        <field name="model">xb.wish.type</field>
        <field name="arch" type="xml">
            <search string="Reminder Types">
                <field name="name"/>
                <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                <filter name="filter_show_in_pos" string="Visible in POS" domain="[('show_in_pos','=',True)]"/>
                <separator/>
                <group>
                    <filter name="group_period" string="Period" context="{'group_by':'period_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="xb_wish_type_action" model="ir.actions.act_window">
        <field name="name">Reminder Types</field>
        <field name="res_model">xb.wish.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="xb_wish_type_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first reminder type</p>
            <p>Define the kinds of special dates you want to track:
               Birthday, Anniversary, Contract Renewal, etc.</p>
        </field>
    </record>

</odoo>
