<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The signature image is rendered by Odoo's NATIVE delivery-slip block
         (stock.report_delivery_document, div[name='signature'], which prints
         o.signature). We only enrich that native block with who signed and
         when, gated on the company toggle, so there is never a duplicate image. -->
    <template id="report_delivery_document_xb_signature"
              inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='signature']" position="inside">
            <div t-if="o.company_id.xb_delivery_signature_on_slip and o.xb_delivery_signed_by"
                 class="offset-8 text-center" name="xb_delivery_signed_by">
                <p class="mb-0">
                    <small>Received by: <span t-out="o.xb_delivery_signed_by">John Doe</span></small>
                </p>
                <p t-if="o.xb_delivery_signed_on" class="text-muted">
                    <small><span t-field="o.xb_delivery_signed_on"/></small>
                </p>
            </div>
        </xpath>
    </template>
</odoo>
