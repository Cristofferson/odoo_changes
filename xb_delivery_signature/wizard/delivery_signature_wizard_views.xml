<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_delivery_signature_wizard_form" model="ir.ui.view">
        <field name="name">xb.delivery.signature.wizard.form</field>
        <field name="model">xb.delivery.signature.wizard</field>
        <field name="arch" type="xml">
            <form string="Delivery receipt signature">
                <p class="text-muted">
                    Hand the device to the customer to sign the reception of
                    <field name="picking_id" readonly="1" class="fw-bold" nolabel="1"/>.
                </p>
                <group>
                    <field name="signed_by" placeholder="Customer name"/>
                </group>
                <field name="signature" widget="signature"
                       options="{'full_name': 'signed_by'}" nolabel="1"/>
                <field name="validate_after" invisible="1"/>
                <footer>
                    <button name="action_sign" type="object" string="Confirm signature"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
