<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_nombre_fijo" model="ir.ui.view">
        <field name="name">product.template.form.xb_gema_nombre</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="xb_nombre_fijo" invisible="categ_id != 71"/>
            </field>
        </field>
    </record>
</odoo>
