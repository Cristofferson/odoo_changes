<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_list_captura_peso" model="ir.ui.view">
        <field name="name">product.template.list.captura.peso</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Captura de pesos" editable="bottom" create="0" delete="0"
                  decoration-muted="xb_captura_estado == 'sin_metal'"
                  decoration-success="xb_captura_estado == 'listo'">
                <field name="image_128" widget="image" options="{'size': [48, 48]}" string="Foto" readonly="1"/>
                <field name="default_code" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="xb_se_pesa"/>
                <field name="xb_peso_captura" readonly="xb_captura_estado == 'sin_metal'"/>
                <field name="xb_hechura" readonly="xb_captura_estado == 'sin_metal'"/>
                <field name="xb_precio_por_metal" widget="boolean_toggle" string="Por metal"/>
                <field name="xb_precio_desde"/>
                <field name="xb_captura_estado" widget="badge"
                       decoration-warning="xb_captura_estado == 'falta'"
                       decoration-success="xb_captura_estado == 'listo'"/>
            </list>
        </field>
    </record>

    <record id="view_product_template_search_captura_peso" model="ir.ui.view">
        <field name="name">product.template.search.captura.peso</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="before">
                <filter name="xb_argollas" string="Argollas"
                        domain="[('categ_id.complete_name', '=like', 'Anillo / Argolla%')]"/>
                <filter name="xb_falta_peso" string="Falta peso"
                        domain="['|', ('x_studio_peso_joya', '=', False), ('x_studio_peso_joya', '=', '')]"/>
                <separator/>
            </filter>
        </field>
    </record>

    <record id="action_captura_peso" model="ir.actions.act_window">
        <field name="name">Captura de pesos</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_template_list_captura_peso"/>
        <field name="search_view_id" ref="product.product_template_search_view"/>
        <field name="context">{'search_default_xb_argollas': 1, 'search_default_xb_falta_peso': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay joyas que capturar</p>
            <p>Quita el filtro «Falta peso» para ver las que ya tienen.</p>
        </field>
    </record>

    <menuitem id="menu_captura_peso" name="Captura de pesos" action="action_captura_peso"
              parent="sale.product_menu_catalog" sequence="40"/>
</odoo>
