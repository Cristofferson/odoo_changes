<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Atributos para filtros de tienda. Piezas únicas: sin variantes. -->

    <record id="attr_marca" model="product.attribute">
        <field name="name">Marca</field>
        <field name="create_variant">no_variant</field>
        <field name="display_type">radio</field>
        <field name="visibility">visible</field>
    </record>
    <record id="attr_marca_sin" model="product.attribute.value">
        <field name="attribute_id" ref="attr_marca"/><field name="name">Sin marca / hechura particular</field><field name="sequence">99</field>
    </record>
    <record id="attr_marca_anello" model="product.attribute.value">
        <field name="attribute_id" ref="attr_marca"/><field name="name">Anello</field>
    </record>
    <record id="attr_marca_tiffany" model="product.attribute.value">
        <field name="attribute_id" ref="attr_marca"/><field name="name">Tiffany &amp; Co.</field>
    </record>
    <record id="attr_marca_cartier" model="product.attribute.value">
        <field name="attribute_id" ref="attr_marca"/><field name="name">Cartier</field>
    </record>
    <record id="attr_marca_otra" model="product.attribute.value">
        <field name="attribute_id" ref="attr_marca"/><field name="name">Otra marca</field><field name="sequence">98</field>
    </record>

    <record id="attr_estilo" model="product.attribute">
        <field name="name">Estilo</field>
        <field name="create_variant">no_variant</field>
        <field name="display_type">radio</field>
        <field name="visibility">visible</field>
    </record>
    <record id="attr_estilo_solitario" model="product.attribute.value">
        <field name="attribute_id" ref="attr_estilo"/><field name="name">Solitario</field>
    </record>
    <record id="attr_estilo_halo" model="product.attribute.value">
        <field name="attribute_id" ref="attr_estilo"/><field name="name">Halo</field>
    </record>
    <record id="attr_estilo_trilogia" model="product.attribute.value">
        <field name="attribute_id" ref="attr_estilo"/><field name="name">Trilogía</field>
    </record>
    <record id="attr_estilo_pave" model="product.attribute.value">
        <field name="attribute_id" ref="attr_estilo"/><field name="name">Pavé</field>
    </record>
    <record id="attr_estilo_vintage" model="product.attribute.value">
        <field name="attribute_id" ref="attr_estilo"/><field name="name">Vintage</field>
    </record>
    <record id="attr_estilo_otro" model="product.attribute.value">
        <field name="attribute_id" ref="attr_estilo"/><field name="name">Otro</field><field name="sequence">99</field>
    </record>

    <record id="attr_metal" model="product.attribute">
        <field name="name">Metal</field>
        <field name="create_variant">no_variant</field>
        <field name="display_type">radio</field>
        <field name="visibility">visible</field>
    </record>
    <record id="attr_metal_ob14" model="product.attribute.value">
        <field name="attribute_id" ref="attr_metal"/><field name="name">Oro blanco 14k</field>
    </record>
    <record id="attr_metal_ob18" model="product.attribute.value">
        <field name="attribute_id" ref="attr_metal"/><field name="name">Oro blanco 18k</field>
    </record>
    <record id="attr_metal_oa14" model="product.attribute.value">
        <field name="attribute_id" ref="attr_metal"/><field name="name">Oro amarillo 14k</field>
    </record>
    <record id="attr_metal_oa18" model="product.attribute.value">
        <field name="attribute_id" ref="attr_metal"/><field name="name">Oro amarillo 18k</field>
    </record>
    <record id="attr_metal_rosa" model="product.attribute.value">
        <field name="attribute_id" ref="attr_metal"/><field name="name">Oro rosa</field>
    </record>
    <record id="attr_metal_platino" model="product.attribute.value">
        <field name="attribute_id" ref="attr_metal"/><field name="name">Platino</field>
    </record>

    <!-- Color, pureza, corte, laboratorio y origen NO se declaran aquí.
         Ya existen en el catálogo de gemas de novadiam, y con mucho más
         detalle que lo que este módulo llegó a definir:
             color   -> product.template.x_studio_color_real  (modelo x_color, D–Z)
             pureza  -> product.template.x_studio_pureza_real (x_purezas, FL–I3)
             corte   -> product.template.x_studio_corte       (x_corte, EX–P)
             lab     -> product.template.x_studio_certificados(x_laboratorios_gemolog)
             origen  -> product.template.x_studio_origen_c    (selection)
         Duplicarlos como atributos obligaba al vendedor a capturar dos veces
         y garantizaba que los dos lados se contradijeran. -->

</odoo>
