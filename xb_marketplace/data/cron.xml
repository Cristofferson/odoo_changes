<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Parámetros de negocio (editables en Ajustes técnicos) -->
        <record id="param_commission_pct" model="ir.config_parameter">
            <field name="key">xb_marketplace.commission_pct</field>
            <field name="value">18</field>
        </record>
        <record id="param_inspection_hours" model="ir.config_parameter">
            <field name="key">xb_marketplace.inspection_hours</field>
            <field name="value">72</field>
        </record>
        <record id="param_contract_version" model="ir.config_parameter">
            <field name="key">xb_marketplace.contract_version</field>
            <field name="value">2026-07-borrador</field>
        </record>

        <record id="cron_release_due" model="ir.cron">
            <field name="name">Marketplace: liberar escrow con inspección vencida</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_release_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
