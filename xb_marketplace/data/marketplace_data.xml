<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Etiqueta con la que se marca el contacto al darse de alta como
         vendedor, para poder filtrarlos desde Contactos sin entrar al
         marketplace. -->
    <record id="partner_tag_vendedor_novadiam" model="res.partner.category">
        <field name="name">Vendedor NOVADIAM</field>
        <field name="color">4</field>
    </record>

    <!-- Folio del anuncio: NV-00001. Sirve de referencia interna y de ID Joya.
         Es distinto del número de serie láser (nv_serial), que se asigna hasta
         que la pieza pasa por el taller. -->
    <record id="seq_nv_listing" model="ir.sequence">
        <field name="name">Anuncio de marketplace Novadiam</field>
        <field name="code">xb_marketplace.listing</field>
        <field name="prefix">NV-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
