<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_parroquia_hoja_wizard_form" model="ir.ui.view">
        <field name="name">parroquia.hoja.wizard.form</field>
        <field name="model">parroquia.hoja.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="fecha_desde"/>
                    <field name="fecha_hasta"/>
                </group>
                <footer>
                    <button name="action_imprimir" string="Imprimir"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_parroquia_hoja_wizard" model="ir.actions.act_window">
        <field name="name">Hoja de intenciones</field>
        <field name="res_model">parroquia.hoja.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
