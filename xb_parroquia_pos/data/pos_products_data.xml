    <record id="producto_mica" model="product.template">
        <field name="name">Mica</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="False"/>
        <field name="list_price">20</field>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_categ_servicios')])]"/>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>
