<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_parroquia_egreso_list" model="ir.ui.view">
        <field name="name">parroquia.egreso.list</field>
        <field name="model">parroquia.egreso</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="fecha"/>
                <field name="concepto"/>
                <field name="categoria"/>
                <field name="referencia" optional="show"/>
                <field name="monto" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_parroquia_egreso" model="ir.actions.act_window">
        <field name="name">Egresos</field>
        <field name="res_model">parroquia.egreso</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre el primer egreso</p>
            <p>Gastos del día (comida, papelería, luz, mantenimiento…) con su
               categoría del informe diocesano.</p>
        </field>
    </record>

    <record id="view_parroquia_recibo_form" model="ir.ui.view">
        <field name="name">parroquia.recibo.form</field>
        <field name="model">parroquia.recibo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_report_recibo_ingresos)d" type="action"
                            string="Imprimir recibo" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>Recibo <field name="folio" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="fecha"/>
                            <field name="recibido_de"/>
                        </group>
                        <group>
                            <field name="periodo_desde"/>
                            <field name="periodo_hasta"/>
                            <field name="total" readonly="1"/>
                        </group>
                    </group>
                    <field name="linea_ids">
                        <list editable="bottom">
                            <field name="concepto"/>
                            <field name="monto"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_parroquia_recibo_list" model="ir.ui.view">
        <field name="name">parroquia.recibo.list</field>
        <field name="model">parroquia.recibo</field>
        <field name="arch" type="xml">
            <list>
                <field name="folio"/>
                <field name="fecha"/>
                <field name="recibido_de"/>
                <field name="total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_parroquia_recibo" model="ir.actions.act_window">
        <field name="name">Recibos de ingresos</field>
        <field name="res_model">parroquia.recibo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_parroquia_informe_wizard" model="ir.ui.view">
        <field name="name">parroquia.informe.wizard.form</field>
        <field name="model">parroquia.informe.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="fecha_desde"/>
                    <field name="fecha_hasta"/>
                </group>
                <footer>
                    <button name="action_imprimir_informe" string="Imprimir informe"
                            type="object" class="btn-primary"/>
                    <button name="action_crear_recibo" string="Crear recibo de ingresos"
                            type="object"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_parroquia_informe_wizard" model="ir.actions.act_window">
        <field name="name">Informe diocesano</field>
        <field name="res_model">parroquia.informe.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_parroquia_egresos" name="Egresos"
              parent="xb_parroquia.menu_parroquia_root"
              action="action_parroquia_egreso" sequence="48"/>
    <menuitem id="menu_parroquia_informe" name="Informe diocesano"
              parent="xb_parroquia.menu_parroquia_reportes"
              action="action_parroquia_informe_wizard" sequence="20"/>
    <menuitem id="menu_parroquia_recibos" name="Recibos de ingresos"
              parent="xb_parroquia.menu_parroquia_reportes"
              action="action_parroquia_recibo" sequence="30"/>
</odoo>
