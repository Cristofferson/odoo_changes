<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_dia_liturgico" model="ir.cron">
        <field name="name">Parroquia: santo y evangelio del día</field>
        <field name="model_id" ref="model_parroquia_dia_liturgico"/>
        <field name="state">code</field>
        <field name="code">model.cron_actualizar()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=8, minute=30, second=0)"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
