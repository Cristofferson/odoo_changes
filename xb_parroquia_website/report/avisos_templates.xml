<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_avisos">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page"
                     style="font-family: 'DejaVu Serif', Georgia, serif; font-size: 15px; padding: 0 20px;">
                    <h2 class="text-center"
                        style="font-weight: bold; letter-spacing: 2px; margin-bottom: 30px;">
                        AVISOS PARROQUIALES</h2>
                    <ol style="line-height: 2.2;">
                        <li t-foreach="docs.filtered('publicado').sorted(key=lambda a: (a.sequence, a.id))"
                            t-as="aviso" style="margin-bottom: 10px; text-align: justify;">
                            <span t-out="aviso.texto"/>
                        </li>
                    </ol>
                </div>
            </t>
        </t>
    </template>
</odoo>
