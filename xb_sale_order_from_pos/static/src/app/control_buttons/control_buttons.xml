<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <!--
      XUBAX - add a "Create Quotation / Order / Layaway" control button.
      Gated by the per-POS main toggle (xb_enable_sale_order). It is a SEPARATE
      button from the native pos_sale "Quotation/Order" loader, which we do not
      touch. Anchored before the native pricelist button, inside the
      "remaining buttons" block, like the native pos_sale button.
    -->
    <t t-name="xb_sale_order_from_pos.ControlButtons"
       t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_pricelist_button')]" position="before">
            <button t-if="pos.config.xb_enable_sale_order and this.pos.cashier._role != 'minimal'"
                    class="o_xb_create_sale_order_button"
                    t-att-class="buttonClass"
                    t-on-click="() => this.xbClickCreateSaleOrder()">
                <i class="fa fa-file-text-o me-1" role="img"
                   aria-label="Create Sale Order" title="Create Sale Order"/>
                Create Order
            </button>
        </xpath>
    </t>
</templates>
