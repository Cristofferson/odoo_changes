<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.xb.mx.forma.pago</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="xb_company_country_code" invisible="1"/>
                <field name="l10n_mx_edi_payment_method_id"
                       options="{'no_create': True}"
                       invisible="xb_company_country_code != 'MX'"/>
            </field>
        </field>
    </record>
</odoo>
