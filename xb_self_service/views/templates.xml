<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cart panel: customer chooses — reserve in store, or book an advisor -->
    <template id="cart_self_service" inherit_id="website_sale.cart"
              name="Self-Service: reserve or book">
        <xpath expr="//t[@t-call='website_sale.cart_lines']" position="after">
            <t t-if="website.self_service_enabled and website_sale_order and website_sale_order.order_line">
                <div class="card border-0 shadow-sm mt-4 xb-selfservice">
                    <div class="card-body text-center py-4">
                        <h4 class="mb-2">¿Lista tu selección?</h4>
                        <p class="text-muted mb-4">Tú decides cómo continuar. En ambos casos te atendemos en la tienda, sin pago en línea.</p>
                        <div class="row justify-content-center g-3">
                            <div class="col-12 col-sm-6 col-md-5">
                                <form action="/jewelry/reserve" method="post" class="mb-0">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-primary btn-lg w-100">
                                        <i class="fa fa-bookmark me-2"/>Apartar en tienda
                                    </button>
                                </form>
                                <small class="d-block text-muted mt-2">Resérvala sin pago y recógela en el mostrador.</small>
                            </div>
                            <div class="col-12 col-sm-6 col-md-5">
                                <a t-att-href="website.self_service_appointment_url or '/appointment'"
                                   class="btn btn-outline-primary btn-lg w-100">
                                    <i class="fa fa-calendar me-2"/>Agendar asesoría
                                </a>
                                <small class="d-block text-muted mt-2">Te acompaña un asesor experto, cuando gustes.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Confirmation page after reserving -->
    <template id="reserve_confirmation" name="Self-Service Reservation Confirmed">
        <t t-call="website.layout">
            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-lg-7 text-center">
                        <div class="display-4 mb-3">💎</div>
                        <h1 class="mb-3">¡Selección apartada!</h1>
                        <p class="lead mb-1">Tu referencia es
                            <strong t-esc="order_ref"/>.
                        </p>
                        <p class="text-muted">
                            Pasa al mostrador y un asesor cerrará tu compra. Te esperamos.
                        </p>
                        <a href="/shop" class="btn btn-outline-primary mt-3">
                            Seguir explorando el catálogo
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
