#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_onboarding_view_form
msgid ""
"<b>1. Connect a social account</b><br/>\n"
"                            The planner writes the posts; Odoo's own Social\n"
"                            Marketing publishes them. Link at least one\n"
"                            Facebook, Instagram, LinkedIn or X account first."
msgstr "<b>1. Conecta una cuenta de redes</b><br/> El planificador escribe las publicaciones; el Marketing Social nativo de Odoo las publica. Primero enlaza al menos una cuenta de Facebook, Instagram, LinkedIn o X."

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_onboarding_view_form
msgid "<b>1. Social accounts connected</b><br/>"
msgstr "<b>1. Cuentas de redes conectadas</b><br/>"

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_onboarding_view_form
msgid "<b>2. AI engine ready</b><br/>"
msgstr "<b>2. Motor de IA listo</b><br/>"

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_onboarding_view_form
msgid "<b>2. Add the API key</b><br/>"
msgstr "<b>2. Agrega la llave de API</b><br/>"

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_onboarding_view_form
msgid ""
"<b>2. Choose an AI engine</b><br/>\n"
"                            Pick which model writes the copy and draws the\n"
"                            images."
msgstr "<b>2. Elige un motor de IA</b><br/> Escoge qué modelo escribe los textos y dibuja las imágenes."

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_onboarding_view_form
msgid "<b>3. Brand profile</b><br/>"
msgstr "<b>3. Perfil de marca</b><br/>"

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_onboarding_view_form
msgid ""
"<b>3. Describe your brand</b><br/>\n"
"                            Voice, audience and value proposition. This is the\n"
"                            context every prompt is built on — and it can be\n"
"                            drafted for you from your own website."
msgstr "<b>3. Describe tu marca</b><br/> Voz, público y propuesta de valor. Es el contexto sobre el que se arma cada prompt, y se puede redactar solo a partir de tu propio sitio web."

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_onboarding_view_form
msgid ""
"<b>4. Generate your month</b><br/>\n"
"                            Available once the steps above are green."
msgstr "<b>4. Genera tu mes</b><br/> Disponible cuando los pasos de arriba estén en verde."

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_onboarding_view_form
msgid ""
"<b>4. Generate your month</b><br/>\n"
"                            The AI writes the monthly strategy and one post per\n"
"                            slot. Nothing is published until you approve it."
msgstr "<b>4. Genera tu mes</b><br/> La IA escribe la estrategia del mes y una publicación por espacio. No se publica nada hasta que tú lo apruebes."

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_content_plan_view_form
msgid ""
"<b>Some AI jobs failed.</b>\n"
"                        Use <b>Retry Failed</b> above, or open the AI Activity\n"
"                        tab to read the error."
msgstr "<b>Algunos trabajos de la IA fallaron.</b> Usa <b>Reintentar fallidos</b> arriba, o abre la pestaña Actividad de la IA para leer el error."

#. module: xb_social_ai_planner
#: model_terms:ir.actions.act_window,help:xb_social_ai_planner.action_xb_social_content_plan
msgid ""
"<b>Start Here</b> walks you through what the planner needs;\n"
"                <b>Generate Month</b> then builds a whole month — strategy,\n"
"                copy, hashtags and images — for you to review and approve."
msgstr "<b>Empezar aquí</b> te lleva paso a paso por lo que el planificador necesita; <b>Generar mes</b> arma después un mes completo —estrategia, textos, hashtags e imágenes— para que lo revises y lo apruebes."

#. module: xb_social_ai_planner
#: model_terms:ir.ui.view,arch_db:xb_social_ai_planner.xb_social_content_plan_view_form
msgid "<b>The AI is working on this month.</b>"
msgstr "<b>La IA está trabajando en este mes.</b>"

