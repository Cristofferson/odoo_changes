<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Odoo 19 security model:
            - res.groups.category_id replaced by privilege_id (res.groups.privilege).
            - res.groups.users renamed to user_ids.
        -->
        <record id="module_category_xb_social_ai_planner" model="ir.module.category">
            <field name="name">AI Social Planner</field>
            <field name="description">Plan and generate social media content with AI.</field>
            <field name="sequence">25</field>
        </record>

        <record id="res_groups_privilege_xb_social_ai_planner" model="res.groups.privilege">
            <field name="name">AI Social Planner</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_xb_social_ai_planner"/>
        </record>

        <record id="group_xb_social_planner_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_xb_social_ai_planner"/>
            <field name="comment">Create plans, generate content, approve and push posts.</field>
        </record>

        <record id="group_xb_social_planner_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_xb_social_ai_planner"/>
            <field name="implied_ids" eval="[(4, ref('group_xb_social_planner_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Manage brand profiles, AI providers, keys and generation jobs.</field>
        </record>

        <!-- Multi-company record rules -->
        <record id="xb_social_brand_profile_company_rule" model="ir.rule">
            <field name="name">Brand Profile: Multi-Company</field>
            <field name="model_id" ref="model_xb_social_brand_profile"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="xb_social_content_plan_company_rule" model="ir.rule">
            <field name="name">Content Plan: Multi-Company</field>
            <field name="model_id" ref="model_xb_social_content_plan"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="xb_social_plan_item_company_rule" model="ir.rule">
            <field name="name">Plan Item: Multi-Company</field>
            <field name="model_id" ref="model_xb_social_plan_item"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="xb_social_generation_job_company_rule" model="ir.rule">
            <field name="name">Generation Job: Multi-Company</field>
            <field name="model_id" ref="model_xb_social_generation_job"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="xb_social_competitor_company_rule" model="ir.rule">
            <field name="name">Competitor: Multi-Company</field>
            <field name="model_id" ref="model_xb_social_competitor"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="xb_social_ai_provider_company_rule" model="ir.rule">
            <field name="name">AI Provider: Multi-Company</field>
            <field name="model_id" ref="model_xb_social_ai_provider"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
