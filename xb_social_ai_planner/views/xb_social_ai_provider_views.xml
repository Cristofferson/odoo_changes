<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_social_ai_provider_view_form" model="ir.ui.view">
        <field name="name">xb.social.ai.provider.form</field>
        <field name="model">xb.social.ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Text / Strategy">
                            <field name="provider_type"/>
                            <field name="text_model"/>
                            <field name="effort"/>
                            <field name="max_tokens"/>
                            <field name="timeout"/>
                            <field name="api_base_url"
                                   placeholder="Leave empty for provider default"
                                   invisible="provider_type == 'claude_code'"/>
                            <field name="cli_binary"
                                   invisible="provider_type != 'claude_code'"/>
                            <field name="cli_config_dir"
                                   placeholder="e.g. /opt/odoo/.claude (optional)"
                                   invisible="provider_type != 'claude_code'"/>
                        </group>
                        <group string="Images">
                            <field name="image_provider_type"/>
                            <field name="image_model"
                                   placeholder="Leave empty for provider default"
                                   invisible="image_provider_type in ('none', 'svg')"/>
                            <field name="image_api_base_url"
                                   required="image_provider_type == 'custom'"
                                   invisible="image_provider_type in ('none', 'svg')"/>
                            <field name="image_format"
                                   invisible="image_provider_type == 'none'"/>
                            <field name="image_style"
                                   invisible="image_provider_type in ('none', 'svg')"/>
                            <field name="image_quality"
                                   invisible="image_provider_type in ('none', 'svg')"/>
                            <field name="image_count"
                                   invisible="image_provider_type == 'none'"/>
                            <field name="image_prompt_boost"
                                   invisible="image_provider_type in ('none', 'svg')"/>
                            <field name="image_timeout"
                                   invisible="image_provider_type in ('none', 'svg')"/>
                        </group>
                        <group string="Other">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted"
                         invisible="image_provider_type != 'svg'">
                        Images are drawn by the text model as vector art and
                        rasterised on the server: no image API key and nothing
                        billed per image. It produces on-brand graphics, not
                        photographs — switch to OpenAI or Gemini for photoreal
                        imagery. (Needs the optional
                        <code>cairosvg</code> Python library.)
                    </div>
                    <div class="text-muted"
                         invisible="image_provider_type not in ('openai_images', 'gemini_images', 'custom')">
                        Photoreal images are billed per image by the provider.
                        Set the key in Settings ▸ AI Social Planner ▸
                        <em>AI Image API Key</em>.
                    </div>
                    <div class="text-muted"
                         invisible="provider_type == 'claude_code'">
                        The API key is set in Settings ▸ AI Social Planner, not here.
                    </div>
                    <div class="text-muted"
                         invisible="provider_type != 'claude_code'">
                        No API key needed: this reuses a Claude Code subscription
                        on the server. The <code>claude</code> binary and its
                        login must be reachable by the Odoo service user.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="xb_social_ai_provider_view_list" model="ir.ui.view">
        <field name="name">xb.social.ai.provider.list</field>
        <field name="model">xb.social.ai.provider</field>
        <field name="arch" type="xml">
            <list string="AI Providers">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="text_model"/>
                <field name="image_provider_type"/>
            </list>
        </field>
    </record>

    <record id="action_xb_social_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">xb.social.ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
