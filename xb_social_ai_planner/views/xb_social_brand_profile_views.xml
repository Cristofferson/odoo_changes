<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_social_brand_profile_view_form" model="ir.ui.view">
        <field name="name">xb.social.brand.profile.form</field>
        <field name="model">xb.social.brand.profile</field>
        <field name="arch" type="xml">
            <form string="Brand Profile">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_plans" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="plan_count" widget="statinfo" string="Plans"/>
                        </button>
                        <button name="action_view_competitors" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="competitor_count" widget="statinfo" string="Competitors"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Acme Coffee"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="industry"/>
                            <field name="default_language"/>
                            <field name="emoji_policy"/>
                            <field name="hashtag_policy"/>
                        </group>
                        <group>
                            <field name="default_account_ids" widget="many2many_tags"/>
                            <field name="default_utm_campaign_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Voice &amp; Audience" name="voice">
                            <group>
                                <field name="brand_voice" placeholder="Friendly, expert, concise…"/>
                                <field name="target_audience"/>
                                <field name="value_proposition"/>
                                <field name="cta_style"/>
                            </group>
                        </page>
                        <page string="Keywords" name="keywords">
                            <group>
                                <field name="keywords" placeholder="Themes/keywords to weave in"/>
                                <field name="banned_words" placeholder="Words to avoid"/>
                            </group>
                        </page>
                        <page string="Schedule &amp; Autopilot" name="schedule">
                            <group>
                                <group string="Posting Days">
                                    <field name="post_mon"/>
                                    <field name="post_tue"/>
                                    <field name="post_wed"/>
                                    <field name="post_thu"/>
                                    <field name="post_fri"/>
                                    <field name="post_sat"/>
                                    <field name="post_sun"/>
                                </group>
                                <group string="Posting Times">
                                    <field name="posting_times" placeholder="10:00, 18:30"/>
                                    <field name="tz"/>
                                    <div class="text-muted" colspan="2">
                                        Posts are spread evenly across the days and
                                        times chosen here.
                                    </div>
                                </group>
                            </group>
                            <group string="Autopilot">
                                <group>
                                    <field name="autopilot"/>
                                    <field name="autopilot_day"
                                           invisible="not autopilot"
                                           required="autopilot"/>
                                    <field name="autopilot_user_id"
                                           invisible="not autopilot"/>
                                </group>
                                <group>
                                    <field name="autopilot_posts_per_week"
                                           invisible="not autopilot"/>
                                    <field name="autopilot_images"
                                           invisible="not autopilot"/>
                                </group>
                            </group>
                            <div class="text-muted" invisible="not autopilot">
                                From that day of the month onwards, next month's plan is
                                generated automatically using the default accounts, and
                                the person above gets an activity to review and approve
                                it. Nothing is published without approval.
                            </div>
                        </page>
                        <page string="Visual / Brand Kit" name="visual">
                            <group>
                                <group string="Logo">
                                    <field name="logo" widget="image" class="oe_avatar"/>
                                </group>
                                <group string="Palette">
                                    <field name="palette_primary" widget="color"/>
                                    <field name="palette_secondary" widget="color"/>
                                    <field name="palette_accent" widget="color"/>
                                    <field name="font_hint" placeholder="e.g. elegant serif"/>
                                </group>
                            </group>
                            <group>
                                <field name="visual_style" nolabel="1"
                                       placeholder="Art-direction notes for AI images: mood, composition, motifs, what to avoid…"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="xb_social_brand_profile_view_list" model="ir.ui.view">
        <field name="name">xb.social.brand.profile.list</field>
        <field name="model">xb.social.brand.profile</field>
        <field name="arch" type="xml">
            <list string="Brand Profiles">
                <field name="name"/>
                <field name="industry"/>
                <field name="plan_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_xb_social_brand_profile" model="ir.actions.act_window">
        <field name="name">Brand Profiles</field>
        <field name="res_model">xb.social.brand.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
