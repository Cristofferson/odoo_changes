<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_social_competitor_view_form" model="ir.ui.view">
        <field name="name">xb.social.competitor.form</field>
        <field name="model">xb.social.competitor</field>
        <field name="arch" type="xml">
            <form string="Competitor">
                <header>
                    <button name="action_scrape_website" type="object"
                            string="Scrape Website" class="btn-secondary"
                            invisible="not website"/>
                    <button name="action_analyze" type="object"
                            string="Analyze with AI" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Competitor Co."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand_profile_id"/>
                            <field name="website" widget="url"/>
                            <field name="last_scraped" readonly="1"/>
                        </group>
                        <group>
                            <field name="key_themes" readonly="1"/>
                            <field name="tone" readonly="1"/>
                            <field name="analyzed_on" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="AI Analysis" name="analysis">
                            <field name="analysis_summary" readonly="1"/>
                            <separator string="Content Gaps / Opportunities"/>
                            <field name="opportunities" readonly="1"/>
                        </page>
                        <page string="Inputs" name="inputs">
                            <group>
                                <field name="social_handles"
                                       placeholder="@handle, profile URLs (reference only)"/>
                                <field name="manual_samples"
                                       placeholder="Paste example posts/captions here"/>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page string="Scraped Text" name="scraped">
                            <field name="scraped_content" readonly="1"/>
                        </page>
                    </notebook>
                    <div class="text-muted">
                        Only public web pages are scraped. Social network feeds are
                        not scraped (the platforms forbid it) — paste sample posts above.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="xb_social_competitor_view_list" model="ir.ui.view">
        <field name="name">xb.social.competitor.list</field>
        <field name="model">xb.social.competitor</field>
        <field name="arch" type="xml">
            <list string="Competitors">
                <field name="name"/>
                <field name="brand_profile_id"/>
                <field name="website" widget="url"/>
                <field name="key_themes"/>
                <field name="analyzed_on"/>
            </list>
        </field>
    </record>

    <record id="action_xb_social_competitor" model="ir.actions.act_window">
        <field name="name">Competitors</field>
        <field name="res_model">xb.social.competitor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
