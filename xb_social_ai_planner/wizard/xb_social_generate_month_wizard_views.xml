<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_social_generate_month_wizard_form" model="ir.ui.view">
        <field name="name">xb.social.generate.month.wizard.form</field>
        <field name="model">xb.social.generate.month.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Monthly Content Plan">
                <sheet>
                    <group>
                        <group>
                            <field name="brand_profile_id"/>
                            <field name="plan_date"/>
                            <field name="posts_per_week"/>
                        </group>
                        <group>
                            <field name="account_ids" widget="many2many_tags"/>
                            <field name="utm_campaign_id"/>
                            <field name="ai_provider_id"/>
                            <field name="also_generate_images"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The AI builds the monthly strategy and queues the copy for
                        each post. Generation runs in the background — refresh the
                        plan in a minute or two.
                    </div>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generate"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_xb_social_generate_month_wizard" model="ir.actions.act_window">
        <field name="name">Generate Month</field>
        <field name="res_model">xb.social.generate.month.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
