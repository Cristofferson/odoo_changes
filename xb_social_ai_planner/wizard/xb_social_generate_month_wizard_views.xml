<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_social_generate_month_wizard_form" model="ir.ui.view">
        <field name="name">xb.social.generate.month.wizard.form</field>
        <field name="model">xb.social.generate.month.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Monthly Content Plan">
                <sheet>
                    <group>
                        <group>
                            <field name="brand_profile_id"/>
                            <field name="plan_date"/>
                            <field name="posts_per_week"/>
                        </group>
                        <group>
                            <field name="account_ids" widget="many2many_tags"/>
                            <field name="utm_campaign_id"/>
                            <field name="ai_provider_id"/>
                            <field name="also_generate_images"/>
                        </group>
                    </group>
                    <!-- What you are about to ask for, before it is paid for -->
                    <div class="alert alert-info" role="status"
                         invisible="not schedule_preview">
                        <i class="fa fa-calendar me-2" title="Schedule"/>
                        <field name="schedule_preview" class="oe_inline"/>
                        <div class="text-muted mt-1">
                            Slots come from the brand's posting days and times.
                            Change them on the brand profile.
                        </div>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not schedule_problem">
                        <field name="schedule_problem" class="oe_inline"/>
                    </div>
                    <field name="post_count" invisible="1"/>
                    <div class="text-muted">
                        The AI builds the monthly strategy and then writes each
                        post. It runs in the background and the plan shows its
                        own progress — nothing is published until you approve it.
                    </div>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generate"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_xb_social_generate_month_wizard" model="ir.actions.act_window">
        <field name="name">Generate Month</field>
        <field name="res_model">xb.social.generate.month.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
