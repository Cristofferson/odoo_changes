<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_xb_support_agent" model="ir.cron">
        <field name="name">Agente de WhatsApp: contestar mensajes</field>
        <field name="model_id" ref="model_xb_support_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_xb_support_service_billing" model="ir.cron">
        <field name="name">Agente de WhatsApp: cobro mensual de servicios</field>
        <field name="model_id" ref="model_xb_support_service"/>
        <field name="state">code</field>
        <field name="code">model._cron_monthly_billing()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall">2026-11-01 14:00:00</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
