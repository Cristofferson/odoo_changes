<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xb_support_knowledge_list" model="ir.ui.view">
        <field name="name">xb.support.knowledge.list</field>
        <field name="model">xb.support.knowledge</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="account_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_xb_support_knowledge_form" model="ir.ui.view">
        <field name="name">xb.support.knowledge.form</field>
        <field name="model">xb.support.knowledge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="kind"/>
                        <field name="account_ids" widget="many2many_tags"/>
                        <field name="active"/>
                    </group>
                    <field name="content" placeholder="Escríbelo como se lo explicarías a un cliente. El agente solo dice lo que esté aquí."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_xb_support_knowledge_search" model="ir.ui.view">
        <field name="name">xb.support.knowledge.search</field>
        <field name="model">xb.support.knowledge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="content"/>
                <group>
                    <filter name="by_kind" string="Tipo" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_xb_support_knowledge" model="ir.actions.act_window">
        <field name="name">Base de conocimiento</field>
        <field name="res_model">xb.support.knowledge</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_kind': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enséñale al agente qué vendes</p>
            <p>Servicios, precios «desde», preguntas frecuentes y reglas. El agente no
               inventa: solo usa lo que esté aquí.</p>
        </field>
    </record>
</odoo>
