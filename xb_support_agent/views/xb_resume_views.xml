<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_xb_support_agent" model="ir.ui.view">
        <field name="name">crm.lead.form.xb.support.agent</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="xb_sa_paused_channel_ids" invisible="1"/>
                <button name="action_xb_sa_resume" type="object" string="Devolver al agente" icon="fa-reply"
                        invisible="not xb_sa_paused_channel_ids"
                        help="Ya terminaste con el cliente: el agente de WhatsApp vuelve a contestarle."/>
            </header>
        </field>
    </record>

    <!-- WhatsApp › Conversaciones la pone xb_whatsapp_conversations (la app de la tienda);
         aquí solo se le agrega lo del agente: quién la atiende, de dónde vino y «Devolver al agente». -->
    <record id="discuss_channel_view_list_xb_wac_agent" model="ir.ui.view">
        <field name="name">discuss.channel.list.xb.whatsapp.conversations.agent</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="xb_whatsapp_conversations.discuss_channel_view_list_xb_wac"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-warning">xb_sa_is_paused</attribute>
            </list>
            <field name="xb_wac_last_dt" position="after">
                <field name="xb_sa_lead_id" string="Oportunidad" optional="hide"/>
                <field name="xb_wa_attended_by" widget="badge"
                       decoration-warning="xb_wa_attended_by == 'person'" decoration-info="xb_wa_attended_by == 'agent'"/>
                <field name="xb_wa_origin" widget="badge"
                       decoration-success="xb_wa_origin == 'ad'" decoration-primary="xb_wa_origin == 'web'"/>
                <field name="xb_wa_origin_detail" optional="show"/>
                <field name="xb_sa_is_paused" column_invisible="1"/>
                <field name="xb_sa_paused_until" string="El agente vuelve solo" optional="hide"/>
                <button name="action_xb_sa_resume" type="object" string="Devolver al agente" icon="fa-reply"
                        class="btn-primary" invisible="not xb_sa_is_paused"/>
            </field>
        </field>
    </record>

    <record id="discuss_channel_view_search_xb_wac_agent" model="ir.ui.view">
        <field name="name">discuss.channel.search.xb.whatsapp.conversations.agent</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="xb_whatsapp_conversations.discuss_channel_view_search_xb_wac"/>
        <field name="arch" type="xml">
            <filter name="waiting" position="after">
                <filter name="paused" string="Atendidas por una persona" domain="[('xb_sa_is_paused', '=', True)]"/>
                <separator/>
                <filter name="from_ad" string="Desde anuncio de Meta" domain="[('xb_wa_origin', '=', 'ad')]"/>
                <filter name="from_web" string="Desde el sitio web" domain="[('xb_wa_origin', '=', 'web')]"/>
                <filter name="direct" string="Escribieron directo" domain="[('xb_wa_origin', '=', 'direct')]"/>
            </filter>
            <filter name="group_account" position="before">
                <filter name="group_origin" string="Origen" context="{'group_by': 'xb_wa_origin'}"/>
            </filter>
        </field>
    </record>

    <record id="xb_whatsapp_conversations.action_xb_wac_conversations" model="ir.actions.act_window">
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay conversaciones de WhatsApp.</p>
            <p>Dale clic a una conversación para ver todos sus mensajes y contestar.
               Las de color son las que atiende una persona: al terminar, dale «Devolver al agente»
               o escribe <b>#agente</b> en el chat (no se le manda al cliente).</p>
        </field>
    </record>

    <!-- Los clics al botón de WhatsApp del sitio, junto a los demás reportes. -->
    <record id="xb_whatsapp_web_leads.xb_wa_click_menu" model="ir.ui.menu">
        <field name="parent_id" ref="xb_whatsapp_conversations.menu_xb_wac_reports"/>
        <field name="name">Clics al botón de WhatsApp</field>
        <field name="sequence">2</field>
    </record>
</odoo>
