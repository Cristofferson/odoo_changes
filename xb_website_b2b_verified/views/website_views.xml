<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_form_b2b" model="ir.ui.view">
        <field name="name">website.form.xb_b2b</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='domain']" position="inside">
                <field name="xb_b2b_category_id" options="{'no_create': True}"/>
                <field name="xb_b2b_denied_url" invisible="not xb_b2b_category_id"/>
            </xpath>
        </field>
    </record>
</odoo>
