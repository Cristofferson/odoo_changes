<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_size_guide" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.xb.size.guide</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="inside">
                <setting string="Size guide" help="Link shown next to the size option on the product page.">
                    <field name="xb_size_guide_url" placeholder="/guias/medida-de-anillo"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
