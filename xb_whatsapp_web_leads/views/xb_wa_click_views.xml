<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xb_wa_click_view_list" model="ir.ui.view">
        <field name="name">xb.wa.click.list</field>
        <field name="model">xb.wa.click</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="website_id"/>
                <field name="kind"/>
                <field name="product_tmpl_id"/>
                <field name="path"/>
            </list>
        </field>
    </record>
    <record id="xb_wa_click_view_pivot" model="ir.ui.view">
        <field name="name">xb.wa.click.pivot</field>
        <field name="model">xb.wa.click</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="create_date" interval="week" type="col"/>
                <field name="product_tmpl_id" type="row"/>
            </pivot>
        </field>
    </record>
    <record id="xb_wa_click_view_graph" model="ir.ui.view">
        <field name="name">xb.wa.click.graph</field>
        <field name="model">xb.wa.click</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="create_date" interval="day"/>
            </graph>
        </field>
    </record>
    <record id="xb_wa_click_action" model="ir.actions.act_window">
        <field name="name">Clics a WhatsApp desde el sitio</field>
        <field name="res_model">xb.wa.click</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>
    <menuitem id="xb_wa_click_menu" name="Clics a WhatsApp" parent="whatsapp.whatsapp_menu_main"
              action="xb_wa_click_action" sequence="90"/>
    <record id="xb_wa_lead_action" model="ir.actions.act_window">
        <field name="name">Prospectos de WhatsApp (sitio y anuncios)</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('medium_id.name', '=', 'WhatsApp')]</field>
    </record>
    <menuitem id="xb_wa_lead_menu" name="Prospectos del sitio y anuncios" parent="whatsapp.whatsapp_menu_main"
              action="xb_wa_lead_action" sequence="91"/>
</odoo>
