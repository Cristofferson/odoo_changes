<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_sync_displays" model="ir.cron">
            <field name="name">Xibo: Sync displays from CMS</field>
            <field name="model_id" ref="model_xibo_server"/>
            <field name="state">code</field>
            <field name="code">model.search([('active', '=', True), ('state', '=', 'connected')]).action_sync_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_prune_event_log" model="ir.cron">
            <field name="name">Xibo: Prune event log (older than 30 days)</field>
            <field name="model_id" ref="model_xibo_event_log"/>
            <field name="state">code</field>
            <field name="code">model._prune(30)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
