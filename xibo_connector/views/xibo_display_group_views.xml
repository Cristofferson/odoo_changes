<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xibo_display_group_list" model="ir.ui.view">
        <field name="name">xibo.display.group.list</field>
        <field name="model">xibo.display.group</field>
        <field name="arch" type="xml">
            <list string="Display Groups">
                <field name="name"/>
                <field name="server_id"/>
                <field name="is_display_specific" widget="boolean_toggle" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_xibo_display_group_form" model="ir.ui.view">
        <field name="name">xibo.display.group.form</field>
        <field name="model">xibo.display.group</field>
        <field name="arch" type="xml">
            <form string="Display Group">
                <header>
                    <button name="action_collect_now" type="object" string="Trigger Refresh"
                            class="btn-primary" invisible="not xibo_display_group_id"/>
                    <button name="action_open_in_cms" type="object" string="Open in Xibo"
                            class="btn-secondary" icon="fa-external-link"
                            invisible="not xibo_display_group_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="server_id"/>
                            <field name="xibo_display_group_id" readonly="1"/>
                            <field name="is_display_specific" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Displays in this group">
                            <field name="display_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="logged_in" readonly="1"/>
                                    <field name="last_accessed" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_xibo_display_group" model="ir.actions.act_window">
        <field name="name">Display Groups</field>
        <field name="res_model">xibo.display.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
