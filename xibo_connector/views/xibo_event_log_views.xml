<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xibo_event_log_list" model="ir.ui.view">
        <field name="name">xibo.event.log.list</field>
        <field name="model">xibo.event.log</field>
        <field name="arch" type="xml">
            <list string="Xibo Event Log" create="false" edit="false"
                  decoration-success="success" decoration-danger="not success">
                <field name="create_date"/>
                <field name="server_id"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="duration_ms"/>
                <field name="success" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_xibo_event_log_form" model="ir.ui.view">
        <field name="name">xibo.event.log.form</field>
        <field name="model">xibo.event.log</field>
        <field name="arch" type="xml">
            <form string="Event" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="server_id"/>
                            <field name="method"/>
                            <field name="endpoint"/>
                        </group>
                        <group>
                            <field name="status_code"/>
                            <field name="success"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group string="Request">
                        <field name="request_summary" nolabel="1"/>
                    </group>
                    <group string="Response">
                        <field name="response_summary" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_xibo_event_log" model="ir.actions.act_window">
        <field name="name">Event Log</field>
        <field name="res_model">xibo.event.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
