<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xibo_layout_list" model="ir.ui.view">
        <field name="name">xibo.layout.list</field>
        <field name="model">xibo.layout</field>
        <field name="arch" type="xml">
            <list string="Layouts">
                <field name="name"/>
                <field name="server_id"/>
                <field name="xibo_layout_id"/>
                <field name="is_overlay" widget="boolean_toggle"/>
                <field name="duration"/>
                <field name="width"/>
                <field name="height"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_xibo_layout_form" model="ir.ui.view">
        <field name="name">xibo.layout.form</field>
        <field name="model">xibo.layout</field>
        <field name="arch" type="xml">
            <form string="Layout">
                <header>
                    <button name="action_open_in_cms" type="object" string="Open in Xibo"
                            class="btn-primary" icon="fa-external-link"
                            invisible="not xibo_layout_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="server_id"/>
                            <field name="xibo_layout_id" readonly="1"/>
                            <field name="xibo_campaign_id" readonly="1"/>
                            <field name="tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="is_overlay"/>
                            <field name="duration"/>
                            <field name="width" readonly="1"/>
                            <field name="height" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_xibo_layout" model="ir.actions.act_window">
        <field name="name">Layouts</field>
        <field name="res_model">xibo.layout</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
