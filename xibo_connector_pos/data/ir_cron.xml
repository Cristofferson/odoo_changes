<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Cron: Garbage-collect expired POS Thank-You renders.

            The `xibo.thanks.render` table is a TTL-bounded ledger of the
            Thank-You messages that have been published. Each record expires
            ~60s after creation (just enough to outlast the display window).
            This cron clears records whose `expires_at` is more than 1 hour
            in the past, keeping a brief tail useful for debugging.

            Runs every 30 minutes. Lightweight: a single indexed SELECT plus
            an UNLINK of at most 500 rows.
        -->
        <record id="ir_cron_xibo_thanks_render_gc" model="ir.cron">
            <field name="name">Xibo POS: Clean Expired Thank-You Renders</field>
            <field name="model_id" ref="model_xibo_thanks_render"/>
            <field name="state">code</field>
            <field name="code">model._gc_expired()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
