<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_xibo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.xibo_pos.v5</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block id="pos_xibo_signage_section" title="Xibo Signage"
                       help="Send AI-powered thank-you, dynamic customer display mirror and contextual recommendations to Xibo screens."
                       invisible="not pos_config_id">

                    <setting string="Xibo Server"
                             help="Xibo CMS that this POS will broadcast to. Leave empty to disable.">
                        <field name="pos_xibo_server_id" options="{'no_create': True}"/>
                    </setting>

                    <setting string="Active Time Window"
                             help="Time of day when broadcasts from this POS are sent."
                             invisible="not pos_xibo_server_id">
                        <div class="o_row">
                            <field name="pos_xibo_time_from" widget="float_time"/>
                            <span class="mx-2">to</span>
                            <field name="pos_xibo_time_to" widget="float_time"/>
                        </div>
                    </setting>

                    <setting string="Default Displays"
                             help="Screens that receive broadcasts by default."
                             invisible="not pos_xibo_server_id">
                        <field name="pos_xibo_display_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </setting>

                    <setting string="Default Display Groups"
                             help="Display groups that receive broadcasts by default."
                             invisible="not pos_xibo_server_id">
                        <field name="pos_xibo_display_group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </setting>

                    <!-- ============ ① AI Thank-You ============ -->
                    <setting string="① AI-Powered Thank-You"
                             help="Generate a personalized thank-you message with AI when an order is paid. The AI considers customer name, most expensive product, and category to craft a relevant message."
                             invisible="not pos_xibo_server_id">
                        <field name="pos_xibo_thanks_enabled"/>
                        <div class="content-group mt16" invisible="not pos_xibo_thanks_enabled">
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_use_ai" class="col-lg-4 o_light_label" string="Use AI"/>
                                <div class="col-lg-8">
                                    <field name="pos_xibo_thanks_use_ai"/>
                                    <span class="text-muted ms-2">If off, the fallback template is used directly.</span>
                                </div>
                            </div>
                            <div class="row mt8" invisible="not pos_xibo_thanks_use_ai">
                                <label for="pos_xibo_thanks_ai_agent_id" class="col-lg-4 o_light_label" string="AI Agent"/>
                                <field name="pos_xibo_thanks_ai_agent_id" options="{'no_create': True}" class="col-lg-8"/>
                            </div>
                            <div class="row mt8" invisible="not pos_xibo_thanks_use_ai">
                                <label for="pos_xibo_thanks_ai_prompt" class="col-lg-4 o_light_label" string="AI Prompt"/>
                                <field name="pos_xibo_thanks_ai_prompt" class="col-lg-8" widget="text"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_fallback_text" class="col-lg-4 o_light_label" string="Fallback Template"/>
                                <field name="pos_xibo_thanks_fallback_text" class="col-lg-8" placeholder="Thanks, {customer_name}!"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_layout_id" class="col-lg-4 o_light_label" string="Thank-You Layout in Xibo"/>
                                <field name="pos_xibo_thanks_layout_id" options="{'no_create': True}" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_duration" class="col-lg-4 o_light_label" string="Display For (s)"/>
                                <field name="pos_xibo_thanks_duration" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_min_amount" class="col-lg-4 o_light_label" string="Minimum Order Total"/>
                                <field name="pos_xibo_thanks_min_amount" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_display_ids" class="col-lg-4 o_light_label" string="Target Screens"/>
                                <div class="col-lg-8">
                                    <field name="pos_xibo_thanks_display_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <div class="text-muted small mt-1">
                                        The Thank-You Layout on each screen must contain a single Webpage widget pointing to the URL below on this server.
                                    </div>
                                </div>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_url" class="col-lg-4 o_light_label" string="Webpage URL (with key)"/>
                                <div class="col-lg-8">
                                    <field name="pos_xibo_thanks_url" readonly="1" class="text-break"/>
                                    <div class="text-muted small mt-1">
                                        Paste this into the Xibo Webpage widget. It already includes the secret key.
                                    </div>
                                </div>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_require_token" class="col-lg-4 o_light_label" string="Require key"/>
                                <div class="col-lg-8">
                                    <field name="pos_xibo_thanks_require_token"/>
                                    <div class="text-muted small mt-1">
                                        Leave OFF until every screen above uses the URL with the key. Turn ON to stop outsiders who guess the id from reading the Thank-You page.
                                    </div>
                                </div>
                            </div>

                            <h5 class="mt-4 mb-2">Visual Style</h5>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_preset" class="col-lg-4 o_light_label" string="Preset"/>
                                <field name="pos_xibo_thanks_preset" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_show_product_image" class="col-lg-4 o_light_label" string="Show Top Product Image"/>
                                <field name="pos_xibo_thanks_show_product_image" class="col-lg-8"/>
                            </div>
                            <div class="row mt8" invisible="pos_xibo_thanks_preset != 'custom'">
                                <label for="pos_xibo_thanks_custom_html" class="col-lg-12 o_light_label" string="Custom HTML Template"/>
                                <div class="col-lg-12">
                                    <field name="pos_xibo_thanks_custom_html" widget="html" options="{'style-inline': true}" nolabel="1"/>
                                    <div class="text-muted small mt-1">
                                        Placeholders: <code>{{message}}</code>, <code>{{customer_name}}</code>, <code>{{top_product}}</code>, <code>{{product_image_url}}</code>, <code>{{total}}</code>, <code>{{currency}}</code>, <code>{{company_name}}</code>, <code>{{company_logo_url}}</code>.
                                    </div>
                                </div>
                            </div>

                            <h5 class="mt-4 mb-2">Audio Notification</h5>
                            <div class="row mt8">
                                <label for="pos_xibo_thanks_audio_enabled" class="col-lg-4 o_light_label" string="Enable Audio"/>
                                <field name="pos_xibo_thanks_audio_enabled" class="col-lg-8"/>
                            </div>
                            <div invisible="not pos_xibo_thanks_audio_enabled">
                                <div class="row mt8">
                                    <label for="pos_xibo_thanks_audio_preset" class="col-lg-4 o_light_label" string="Sound Preset"/>
                                    <field name="pos_xibo_thanks_audio_preset" class="col-lg-8"/>
                                </div>
                                <div class="row mt8" invisible="pos_xibo_thanks_audio_preset != 'custom'">
                                    <label for="pos_xibo_thanks_audio_custom_url" class="col-lg-4 o_light_label" string="Custom Audio URL"/>
                                    <div class="col-lg-8">
                                        <field name="pos_xibo_thanks_audio_custom_url"
                                               placeholder="https://example.com/notification.mp3"
                                               required="pos_xibo_thanks_audio_preset == 'custom' and pos_xibo_thanks_audio_enabled"/>
                                        <div class="text-muted small mt-1">
                                            Public URL to an MP3, OGG or WAV. Recommended: under 25KB, under 2 seconds.
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt8">
                                    <label for="pos_xibo_thanks_audio_volume" class="col-lg-4 o_light_label" string="Volume (0-100)"/>
                                    <div class="col-lg-8">
                                        <field name="pos_xibo_thanks_audio_volume"/>
                                        <span class="text-muted ms-2">Also depends on the Video Wall hardware volume.</span>
                                    </div>
                                </div>
                                <div class="alert alert-secondary small mt-2" role="alert">
                                    <strong>Note:</strong> the audio plays inside the Xibo player's embedded browser via HTML5 <code>&lt;audio autoplay&gt;</code>. Some kiosk setups have strict autoplay policies — if you hear no sound, check the player's console log and ensure the Video Wall isn't muted at the OS level.
                                </div>
                            </div>

                            <div class="alert alert-info mt-3" role="alert">
                                <p class="mb-1"><strong>How it works:</strong></p>
                                <ol class="mb-1">
                                    <li>When an order is paid, Odoo collects the customer name, the most expensive product and its category.</li>
                                    <li>The AI generates a short, contextual thank-you message using your prompt template.</li>
                                    <li>The message and selected visual preset are rendered into a fresh HTML page served at <code>/xibo/thanks/&lt;config_id&gt;</code>.</li>
                                    <li>An XMR <code>changeLayout</code> tells the target screens to switch to the Thank-You Layout, whose Webpage widget loads that URL.</li>
                                </ol>
                                <p class="mb-0">
                                    <strong>Async:</strong> the order closes immediately. The broadcast fires a moment later when the AI responds.
                                </p>
                                <p class="mb-0 mt-2">
                                    <strong>Prompt variables:</strong> <code>{customer_name}</code>, <code>{top_product}</code>, <code>{top_category}</code>, <code>{total}</code>, <code>{currency}</code>, <code>{product_list}</code>
                                </p>
                            </div>
                        </div>
                    </setting>

                    <!-- ============ ③ Customer Display Mirror DYNAMIC ============ -->
                    <setting string="③ Dynamic Customer Display Mirror"
                             help="When a product is added to the cart, the configured Xibo screen switches from its normal schedule to mirror the Odoo POS Customer Display. When the cart is cleared (paid or cancelled), the screen reverts to its normal content."
                             invisible="not pos_xibo_server_id">
                        <field name="pos_xibo_customer_display_enabled"/>
                        <div class="content-group mt16" invisible="not pos_xibo_customer_display_enabled">
                            <div class="row mt8">
                                <label for="pos_xibo_customer_display_display_id" class="col-lg-4 o_light_label" string="Target Screen"/>
                                <field name="pos_xibo_customer_display_display_id" options="{'no_create': True}" class="col-lg-8"
                                       required="pos_xibo_customer_display_enabled"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_customer_display_duration" class="col-lg-4 o_light_label" string="Duration (s)"/>
                                <div class="col-lg-8">
                                    <field name="pos_xibo_customer_display_duration"/>
                                    <span class="text-muted ms-2">0 = stay until cart is cleared/paid (recommended).</span>
                                </div>
                            </div>
                            <div class="row mt8" invisible="not pos_xibo_customer_display_url">
                                <label for="pos_xibo_customer_display_url" class="col-lg-4 o_light_label" string="URL Used"/>
                                <div class="col-lg-8">
                                    <field name="pos_xibo_customer_display_url" readonly="1"/>
                                </div>
                            </div>
                            <div class="row mt8" invisible="not pos_xibo_customer_display_layout_id">
                                <label for="pos_xibo_customer_display_layout_id" class="col-lg-4 o_light_label" string="Auto-Created Layout"/>
                                <field name="pos_xibo_customer_display_layout_id" readonly="1" class="col-lg-8"/>
                            </div>
                            <div class="alert alert-success mt-3" role="alert">
                                <p class="mb-1"><strong>Auto-applied at save time:</strong></p>
                                <ol class="mb-0">
                                    <li>The connector creates a Layout in Xibo with a Webpage widget pointing to the Customer Display URL.</li>
                                    <li>When the cashier adds the first product, Xibo's XMR service instantly switches the screen to this Layout.</li>
                                    <li>When the cart is emptied, the screen reverts to its normal schedule.</li>
                                </ol>
                            </div>
                            <div class="alert alert-warning mt-2" role="alert">
                                <p class="mb-1"><strong>Player compatibility:</strong></p>
                                <ul class="mb-0">
                                    <li>Works best on Xibo Player for <b>Windows</b> and <b>Linux</b>.</li>
                                    <li><b>Android</b>, <b>webOS</b> and <b>Tizen</b> players have stricter cookie policies that may break the session-scoped URL.</li>
                                </ul>
                            </div>
                        </div>
                    </setting>

                    <!-- ============ ④ Contextual Recommendations ============ -->
                    <setting string="④ Contextual Recommendations"
                             help="Show Xibo media tagged for the products being added to the cart. Tags come from the product category, optionally overridden per product."
                             invisible="not pos_xibo_server_id">
                        <field name="pos_xibo_reco_enabled"/>
                        <div class="content-group mt16" invisible="not pos_xibo_reco_enabled">
                            <div class="row mt8">
                                <label for="pos_xibo_reco_mode" class="col-lg-4 o_light_label" string="Mode"/>
                                <field name="pos_xibo_reco_mode" widget="radio" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_reco_duration" class="col-lg-4 o_light_label" string="Display For (s)"/>
                                <field name="pos_xibo_reco_duration" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_reco_priority" class="col-lg-4 o_light_label" string="Multi-product Priority"/>
                                <field name="pos_xibo_reco_priority" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="pos_xibo_reco_cooldown" class="col-lg-4 o_light_label" string="Cool-down (s)"/>
                                <field name="pos_xibo_reco_cooldown" class="col-lg-8"/>
                            </div>
                            <div class="alert alert-info mt-3" role="alert">
                                <p class="mb-1"><strong>How it works:</strong></p>
                                <ol class="mb-0">
                                    <li>Tag your Xibo media files in the Xibo Library (e.g. <code>tv,electronics</code>).</li>
                                    <li>Set the same tags on the matching <b>Product Categories</b>.</li>
                                    <li>When the cashier adds a tagged product, the matching Xibo media is broadcast to the configured screens.</li>
                                </ol>
                                <p class="mb-0 mt-2">The cool-down avoids spam: a recommendation cannot fire again within that many seconds.</p>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
