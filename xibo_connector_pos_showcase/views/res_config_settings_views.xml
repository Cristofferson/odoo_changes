<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_xibo_showcase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.xibo_pos_showcase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="xibo_connector_pos.res_config_settings_view_form_xibo"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_xibo_signage_section']" position="inside">
                <!-- ============ ⑤ Videowall Showcase (idle) ============ -->
                <setting string="⑤ Videowall Showcase"
                         help="When idle, the videowall shows a rotating gallery of your online catalog plus a QR code that opens the web store on the customer's phone."
                         invisible="not pos_xibo_server_id">
                    <field name="pos_xibo_showcase_enabled"/>
                    <div class="content-group mt16" invisible="not pos_xibo_showcase_enabled">
                        <div class="row mt8">
                            <label for="pos_xibo_showcase_category_id" class="col-lg-4 o_light_label" string="Showcase Category"/>
                            <div class="col-lg-8">
                                <field name="pos_xibo_showcase_category_id" options="{'no_create': True}"/>
                                <div class="text-muted small mt-1">Optional. Empty = all published pieces.</div>
                            </div>
                        </div>
                        <div class="row mt8">
                            <label for="pos_xibo_showcase_url" class="col-lg-4 o_light_label" string="Catalog URL (QR)"/>
                            <div class="col-lg-8">
                                <field name="pos_xibo_showcase_url" placeholder="https://www.anello.mx/shop"/>
                                <div class="text-muted small mt-1">Where the QR sends the customer. Empty = this server's /shop.</div>
                            </div>
                        </div>
                        <div class="row mt8">
                            <label for="pos_xibo_showcase_order" class="col-lg-4 o_light_label" string="Order"/>
                            <field name="pos_xibo_showcase_order" class="col-lg-8"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_xibo_showcase_count" class="col-lg-4 o_light_label" string="Pieces to Rotate"/>
                            <field name="pos_xibo_showcase_count" class="col-lg-8"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_xibo_showcase_interval" class="col-lg-4 o_light_label" string="Seconds per Piece"/>
                            <field name="pos_xibo_showcase_interval" class="col-lg-8"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_xibo_showcase_heading" class="col-lg-4 o_light_label" string="Call to Action"/>
                            <field name="pos_xibo_showcase_heading" class="col-lg-8"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_xibo_showcase_widget_url" class="col-lg-4 o_light_label" string="Webpage URL"/>
                            <div class="col-lg-8">
                                <field name="pos_xibo_showcase_widget_url" readonly="1" class="text-break"/>
                                <div class="text-muted small mt-1">Paste this into the Xibo Webpage widget of the idle/showcase layout.</div>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
